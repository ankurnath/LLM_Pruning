def extract_feature(G):
    import numpy as np
    weights = {}
    for n, data in G.nodes(data=True):
        weights[n] = data.get('weight', 0.0)
    nodes = list(G.nodes())
    res = np.zeros(len(nodes), dtype=float)
    for i, n in enumerate(nodes):
        neighs = list(G.neighbors(n))
        if not neighs:
            res[i] = 0.0
        else:
            s = 0.0
            for u in neighs:
                s += weights.get(u, 0.0)
            res[i] = s / len(neighs)
    return res

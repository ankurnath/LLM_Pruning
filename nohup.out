import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_indices = {n: i for i, n in enumerate(nodes)}
    weights = np.array([G.nodes[n]['weight'] for n in nodes])
    neighbors = {n: set(G.neighbors(n)) for n in nodes}
    unique_weights = np.zeros(len(nodes))
    for idx, n in enumerate(nodes):
        exclusive_neighbors = set([n])
        for nbr in neighbors[n]:
            shared = False
            for other in neighbors[n]:
                if nbr != other and nbr in neighbors[other]:
                    shared = True
                    break
            if not shared:
                exclusive_neighbors.add(nbr)
        unique_weights[idx] = sum(G.nodes[u]['weight'] for u in exclusive_neighbors)
    total_weights = np.array([sum(G.nodes[u]['weight'] for u in [n] | neighbors[n]) for n in nodes])
    frac = unique_weights / (total_weights + 1e-9)
    if budget > 0:
        frac = np.minimum(frac, budget / (weights + 1e-9))
    return frac

import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    feat = np.zeros(len(nodes), dtype=float)
    if G.is_directed():
        deg_out = dict(G.out_degree())
        for idx, v in enumerate(nodes):
            s = 0.0
            d = 0
            for u in G.successors(v):
                d += 1
                s += deg_out.get(u, 0)
            feat[idx] = 0.0 if d == 0 else s / d
    else:
        deg = dict(G.degree())
        for idx, v in enumerate(nodes):
            s = 0.0
            d = 0
            for u in G.neighbors(v):
                d += 1
                s += deg.get(u, 0)
            feat[idx] = 0.0 if d == 0 else s / d
    return feat

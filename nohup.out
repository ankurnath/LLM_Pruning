def extract_feature(G):
    import numpy as np
    d = 0.85
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.array([], dtype=float)
    idx = {node: i for i, node in enumerate(nodes)}
    out_neighbors = [[] for _ in range(n)]
    out_sum = np.zeros(n, dtype=float)
    for u in nodes:
        i = idx[u]
        total = 0.0
        if G.has_node(u):
            for v, data in G[u].items():
                w = data.get('weight', 1.0)
                j = idx[v]
                out_neighbors[i].append((j, w))
                total += w
        out_sum[i] = total
    weights = np.array([G.nodes[node].get('weight', 1.0) for node in nodes], dtype=float)
    sum_w = weights.sum()
    if sum_w > 0:
        p = weights / sum_w
    else:
        p = np.ones(n, dtype=float) / max(1, n)
    try:
        max_iters = int(budget)
    except NameError:
        max_iters = 100
    tol = 1e-9
    PR = p.copy()
    for _ in range(max_iters):
        PR_new = (1 - d) * p
        total_dangling = 0.0
        for i in range(n):
            val = PR[i]
            s = out_sum[i]
            if s > 0:
                factor = val / s
                for (j, w) in out_neighbors[i]:
                    PR_new[j] += d * factor * w
            else:
                total_dangling += val
        if total_dangling > 0:
            PR_new += d * total_dangling / n
        diff = float(np.linalg.norm(PR_new - PR, 2))
        PR = PR_new
        if diff < tol:
            break
    return PR

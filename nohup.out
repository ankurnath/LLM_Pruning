def extract_feature(G):
    import numpy as np
    node_list = list(G.nodes())
    n = len(node_list)
    if n == 0:
        return np.array([], dtype=float)
    idx = {node: i for i, node in enumerate(node_list)}
    weights_arr = np.array([G.nodes[node].get('weight', 0.0) for node in node_list], dtype=float)
    result = np.zeros(n, dtype=float)
    if G.is_directed():
        for v in node_list:
            total = 0.0
            for u in G.successors(v):
                total += weights_arr[idx[u]]
            result[idx[v]] = total
    else:
        for v in node_list:
            total = 0.0
            for u in G.neighbors(v):
                total += weights_arr[idx[u]]
            result[idx[v]] = total
    return result

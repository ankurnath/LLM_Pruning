import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    covered = []
    for node in node_list:
        neighbors = set(G.neighbors(node))
        neighbors.add(node)
        total_weight = sum(G.nodes[n]['weight'] for n in neighbors)
        graph_weight = sum(G.nodes[n]['weight'] for n in G.nodes())
        covered_fraction = min(total_weight / graph_weight, budget / len(node_list))
        covered.append(covered_fraction)
    return np.array(covered)

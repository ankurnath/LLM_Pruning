def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    idx = {node: i for i, node in enumerate(nodes)}
    deg = {node: int(G.degree(node)) for node in nodes}
    out = np.zeros(len(nodes), dtype=float)
    for v in nodes:
        s = 0
        for u in G.neighbors(v):
            s += deg[u]
        out[idx[v]] = s
    return out

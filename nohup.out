import numpy as np

def extract_feature(G):
    deg = dict(G.degree())
    sum_nei_deg = {v: 0.0 for v in G}
    sum_nei_deg2 = {v: 0.0 for v in G}
    for u, w in G.edges():
        du = deg[u]
        dw = deg[w]
        sum_nei_deg[u] += dw
        sum_nei_deg2[u] += dw * dw
        sum_nei_deg[w] += du
        sum_nei_deg2[w] += du * du
    nodes = list(G.nodes())
    features = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        dv = deg[v]
        if dv == 0:
            features[i] = 0.0
        else:
            s = sum_nei_deg[v]
            s2 = sum_nei_deg2[v]
            features[i] = (s2 - (s * s) / dv) / dv
    return features

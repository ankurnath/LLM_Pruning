import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_indices = {n: i for i, n in enumerate(nodes)}
    uniq_cov = np.zeros(len(nodes))
    for n in nodes:
        nw = G.nodes[n]['weight']
        total = 0
        for neighbor in G.neighbors(n):
            neigh_covs = [G.nodes[other]['weight'] for other in G.neighbors(neighbor) if other != n]
            max_neigh_cov = max(neigh_covs) if neigh_covs else 0
            contrib = max(0, nw - max_neigh_cov)
            total += contrib
        uniq_cov[node_indices[n]] = min(total, budget)
    return uniq_cov

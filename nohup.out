import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    deg = dict(G.degree())
    feat = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        dv = deg[v]
        if dv == 0:
            feat[i] = 0.0
        else:
            s = 0.0
            for u in G.neighbors(v):
                s += deg[u]
            feat[i] = s / dv
    return feat

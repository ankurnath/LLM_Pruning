def extract_feature(G):
    import numpy as np
    import networkx as nx
    weight_attr = None
    for _, _, data in G.edges(data=True):
        if 'weight' in data:
            weight_attr = 'weight'
            break
    pr = nx.pagerank(G, alpha=0.85, weight=weight_attr)
    nodes = list(G.nodes())
    return np.array([pr[n] for n in nodes], dtype=float)

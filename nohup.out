import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    degrees = dict(G.degree())
    weights = dict(G.nodes(data='weight'))
    feature = np.zeros(len(node_list))
    for idx, u in enumerate(node_list):
        neighbors = list(G.neighbors(u))
        if len(neighbors) == 0:
            feature[idx] = 0.0
            continue
        neighbor_degrees = np.array([degrees[v] for v in neighbors])
        neighbor_weights = np.array([weights[v] for v in neighbors])
        if np.std(neighbor_degrees) == 0 or np.std(neighbor_weights) == 0:
            feature[idx] = 0.0
        else:
            corr = np.corrcoef(neighbor_degrees, neighbor_weights)[0,1]
            feature[idx] = corr
    return feature

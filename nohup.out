def extract_feature(G):
    import numpy as np

    n = G.number_of_nodes()
    if n == 0:
        return np.array([], dtype=float)

    nodes = list(G.nodes())
    idx = {node: i for i, node in enumerate(nodes)}

    x = np.ones(n, dtype=float)
    x /= np.linalg.norm(x)

    is_directed = G.is_directed()
    max_iter = 500
    tol = 1e-6

    for _ in range(max_iter):
        y = np.zeros(n, dtype=float)
        if is_directed:
            for u, v, data in G.edges(data=True):
                w = data.get('weight', 1.0)
                y[idx[v]] += w * x[idx[u]]
        else:
            for u, v, data in G.edges(data=True):
                w = data.get('weight', 1.0)
                i, j = idx[u], idx[v]
                y[i] += w * x[j]
                y[j] += w * x[i]

        norm = np.linalg.norm(y)
        if norm == 0:
            y = np.ones(n, dtype=float)
            norm = np.linalg.norm(y)
        y /= norm

        if np.linalg.norm(y - x) < tol:
            x = y
            break
        x = y

    x_norm = np.linalg.norm(x)
    if x_norm > 0:
        x = x / x_norm

    feature = np.array([x[idx[node]] for node in nodes], dtype=float)
    return feature

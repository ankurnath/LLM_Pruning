def extract_feature(G):
    import numpy as np
    import networkx as nx
    n = G.number_of_nodes()
    k = None
    try:
        budget_val = int(budget)
        if budget_val > 0:
            k = min(budget_val, n)
    except Exception:
        k = None
    bc = nx.betweenness_centrality(G, k=k, normalized=False, weight='weight')
    max_b = max(bc.values()) if bc else 0.0
    res = np.zeros(n, dtype=float)
    i = 0
    for v in G:
        val = bc.get(v, 0.0)
        res[i] = (val / max_b) if max_b != 0 else 0.0
        i += 1
    return res

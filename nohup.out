import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    weights = np.array([G.nodes[n]['weight'] for n in node_list])
    neighbor_weights = np.zeros(len(node_list))
    for i, n in enumerate(node_list):
        total = weights[i]
        for nbr in G.neighbors(n):
            idx = node_list.index(nbr)
            total += weights[idx]
        neighbor_weights[i] = total
    normalized = neighbor_weights / budget
    return normalized

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    idx = {node: i for i, node in enumerate(nodes)}
    deg_out_arr = np.zeros(n, dtype=float)
    for i, v in enumerate(nodes):
        deg_out_arr[i] = G.out_degree(v)
    feature = np.zeros(n, dtype=float)
    for i, v in enumerate(nodes):
        total = 0.0
        count = 0
        for u in G.successors(v):
            total += deg_out_arr[idx[u]]
            count += 1
        feature[i] = 0.0 if count == 0 else total / count
    return feature

def extract_feature(G):
    import numpy as np
    if not G.is_directed():
        G = G.to_directed()
    out_deg = dict(G.out_degree())
    nodes = list(G.nodes())
    result = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        nb_dict = G.adj[v]
        if not nb_dict:
            result[i] = 0.0
        else:
            total = 0.0
            for u in nb_dict:
                total += out_deg.get(u, 0)
            result[i] = total / len(nb_dict)
    return result

def extract_feature(G):
    import numpy as np
    import networkx as nx
    UG = nx.Graph(G)
    node_order = list(G.nodes())
    neigh = {v: set(UG.neighbors(v)) for v in node_order}
    res = np.zeros(len(node_order), dtype=np.int64)
    for i, v in enumerate(node_order):
        Nv = neigh[v]
        if len(Nv) < 2:
            res[i] = 0
            continue
        s = 0
        for u in Nv:
            s += len(Nv & neigh[u])
        res[i] = s // 2
    return res

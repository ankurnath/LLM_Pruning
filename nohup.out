def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    wmap = {n: data.get('weight', 0) for n, data in G.nodes(data=True)}
    feature = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        min_w = min((wmap[u] for u in G.neighbors(v)), default=0)
        feature[i] = min_w
    return feature

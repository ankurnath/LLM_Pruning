import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    coverage = {n: set([n]) | set(G.neighbors(n)) for n in nodes}
    all_coverage = set.union(*coverage.values())
    excl_gain = []
    for n in nodes:
        excl = coverage[n] - set.union(*(coverage[m] for m in nodes if m != n and len(excl_gain) < budget))
        gain = sum(G.nodes[v]['weight'] for v in excl)
        excl_gain.append(gain)
    return np.array(excl_gain)

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    weights = np.array([G.nodes[n]['weight'] for n in nodes])
    feature = np.zeros(len(nodes))
    for i, n in enumerate(nodes):
        neighbors = list(G.neighbors(n))
        if budget > 0:
            neighbors = neighbors[:budget]
        if neighbors:
            neighbor_weights = [G.nodes[nb]['weight'] for nb in neighbors]
            variance = np.var(neighbor_weights)
            feature[i] = variance / (np.var(weights) + 1e-9)
        else:
            feature[i] = 0.0
    return feature

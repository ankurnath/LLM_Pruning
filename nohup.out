import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    res = np.zeros(len(nodes), dtype=float)
    for i, u in enumerate(nodes):
        neighbors = set(G.neighbors(u))
        unique_neighbors = neighbors - (node_set - {u})
        denom = min(len(neighbors), budget)
        res[i] = len(unique_neighbors) / denom if denom > 0 else 0.0
    return res

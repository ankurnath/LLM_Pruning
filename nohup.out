import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    feature = np.zeros(len(node_list))
    node_idx = {n: i for i, n in enumerate(node_list)}
    for i, n in enumerate(node_list):
        neighbors = set(G.neighbors(n))
        two_hop = set()
        for nbr in neighbors:
            two_hop.update(G.neighbors(nbr))
        two_hop.discard(n)
        coverage_nodes = neighbors | two_hop | {n}
        total_weight = sum(G.nodes[u]['weight'] for u in coverage_nodes)
        feature[i] = min(total_weight, budget)
    return feature

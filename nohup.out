import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_indices = {node: i for i, node in enumerate(nodes)}
    node_weights = {node: G.nodes[node]['weight'] for node in nodes}
    for idx, node in enumerate(nodes):
        exclusive_neighbors = set(G.neighbors(node)) - set.union(*[set(G.neighbors(n)) for n in G.neighbors(node)] - {node})
        exclusive_weight = sum(node_weights[n] for n in exclusive_neighbors)
        total_exclusive = node_weights[node] + exclusive_weight
        feature[idx] = total_exclusive / budget
    return feature

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(nodes)}
    core_num = nx.core_number(G)
    core_values = np.array([core_num[n] for n in nodes], dtype=float)
    weights = np.array([G.nodes[n]['weight'] for n in nodes], dtype=float)
    feature = np.zeros(len(nodes), dtype=float)
    for i, n in enumerate(nodes):
        neighbors = list(G.neighbors(n))
        if not neighbors:
            feature[i] = 0.0
            continue
        neighbor_weights = np.array([G.nodes[nb]['weight'] for nb in neighbors])
        neighbor_cores = np.array([core_num[nb] for nb in neighbors], dtype=float)
        avg_neighbor_core = neighbor_cores.mean()
        contrast = np.abs(core_values[i] - avg_neighbor_core)
        norm = 1 + np.abs(core_values[i])
        norm_contrast = contrast / norm
        # Budget relevance example: scale by min(weight, budget)/budget
        budget_factor = min(weights[i], budget) / float(budget)
        feature[i] = norm_contrast * budget_factor
    return feature

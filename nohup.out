_avg_deg)\n    max_value = neighbor_avg_deg.max()\n    normed = neighbor_avg_deg / max_value if max_value > 0 else neighbor_avg_deg\n    return normed", 'coverage_benefit_per_cost': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = np.zeros(len(nodes))\n    for i, u in enumerate(nodes):\n        neighbor_weights = sum(G.nodes[v]['weight'] for v in G.neighbors(u))\n        total_coverage = G.nodes[u]['weight'] + neighbor_weights\n        total_cost = G.nodes[u]['weight']\n        if total_cost == 0:\n            feature[i] = 0\n        else:\n            feature[i] = (total_coverage / total_cost) * min(1, budget / total_cost)\n    return feature", 'inverse_neighbors_weight_sum': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = []\n    for node in nodes:\n        neighbors = G.neighbors(node)\n        wsum = sum(G.nodes[nb]['weight'] for nb in neighbors)\n        val = 0 if wsum == 0 else 1.0 / wsum\n        feature.append(val)\n    return np.array(feature)", 'residual_budget_fraction': "import numpy as np\n\ndef extract_feature(G, budget):\n    arr = np.array([max(0, budget - G.nodes[n]['weight']) / budget for n in G.nodes()])\n    return arr", 'normalized_node_weight': "import numpy as np\n\ndef extract_feature(G, budget):\n    weights = np.array([G.nodes[n]['weight'] for n in G.nodes()])\n    normalized_weights = weights / budget\n    return normalized_weights", 'weight_percentile': "import numpy as np\n\ndef extract_feature(G, budget):\n    weights = np.array([G.nodes[n]['weight'] for n in G.nodes()])\n    percentiles = 100.0 * np.argsort(np.argsort(weights)) / (len(weights) - 1)\n    if budget is not None:\n        percentiles = np.minimum(percentiles, budget)\n    return percentiles", 'exclusive_coverage_gain': "import numpy as np\n\ndef extract_feature(G, budget):\n    node_list = list(G.nodes())\n    node_set = set(node_list)\n    feature = []\n    for u in node_list:\n        exclusive_weight = G.nodes[u]['weight']\n        for v in G.neighbors(u):\n            if all((w != u and w != v) for w in G.neighbors(v)):\n                exclusive_weight += G.nodes[v]['weight']\n        exclusive_weight = min(exclusive_weight, budget)\n        feature.append(exclusive_weight)\n    return np.array(feature)", 'neighbor_weight_range': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    res = np.zeros(len(nodes))\n    for idx, node in enumerate(nodes):\n        neighbor_weights = [G.nodes[n]['weight'] for n in G.neighbors(node)]\n        if neighbor_weights:\n            min_w = max(min(neighbor_weights), budget)\n            max_w = min(max(neighbor_weights), budget)\n            res[idx] = max_w - min_w\n        else:\n            res[idx] = 0.0\n    return res", 'isolated_node_indicator': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = np.zeros(len(nodes), dtype=int)\n    for idx, node in enumerate(nodes):\n        if G.degree(node) == 0 and G.nodes[node]['weight'] <= budget:\n            feature[idx] = 1\n    return feature", 'critical_neighbor_fraction': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = []\n    for node in nodes:\n        neighbors = list(G.neighbors(node))\n        if not neighbors:\n            feature.append(0.0)\n            continue\n        crit_count = sum(1 for nb in neighbors if G.nodes[nb].get('weight', 0) >= budget)\n        feature.append(crit_count / len(neighbors))\n    return np.array(feature)"}, 'ratio': 1.0, 'size_reduction': 0.9681449304643567, 'multiplication': 0.9681449304643567}

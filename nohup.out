import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(nodes)}
    n = len(nodes)
    feature = np.zeros(n)
    for i, u in enumerate(nodes):
        visited = set([u])
        first_hop = set(G.neighbors(u))
        visited.update(first_hop)
        second_hop = set()
        for v in first_hop:
            nhbrs_2 = set(G.neighbors(v))
            nhbrs_2.discard(u)
            second_hop.update(nhbrs_2)
        second_hop = second_hop - first_hop
        covered_nodes = {u}
        covered_nodes.update(first_hop)
        covered_nodes.update(second_hop)
        weights = [G.nodes[x]['weight'] for x in covered_nodes]
        weights_sorted = sorted(weights, reverse=True)
        feature[i] = sum(weights_sorted[:budget]) if budget < len(weights_sorted) else sum(weights_sorted)
    return feature

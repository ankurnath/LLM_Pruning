******************************
import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_to_idx = {n: i for i, n in enumerate(nodes)}
    neigh_sets = [set(G.neighbors(n)) | {n} for n in nodes]
    overlaps = np.zeros(len(nodes))
    for i, S_i in enumerate(neigh_sets):
        count = 0
        for j, S_j in enumerate(neigh_sets):
            if i != j and len(S_i & S_j) > 0:
                count += 1
        overlaps[i] = count / min(len(S_i), budget)
    return overlaps

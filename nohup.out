******************************
import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(nodes)}
    n = len(nodes)
    A = np.zeros((n, n))
    w = np.zeros(n)
    for i, u in enumerate(nodes):
        w[i] = G.nodes[u]['weight']
        for j, v in enumerate(nodes):
            if G.has_edge(u, v):
                A[i, j] = G[u][v].get('weight', 1.0)
    C = np.zeros(n)
    for i in range(n):
        nei = [j for j in range(n) if A[i, j] > 0 and w[j] <= budget]
        k = len(nei)
        if k < 2:
            continue
        s = 0.0
        for idx1 in range(k):
            for idx2 in range(idx1 + 1, k):
                j, k_ = nei[idx1], nei[idx2]
                if A[j, k_] > 0:
                    wij = A[i, j]
                    wik = A[i, k_]
                    wjk = A[j, k_]
                    s += (wij + wik) / 2.0
        C[i] = 2 * s / (w[i] * (len(nei) * (len(nei) - 1))) if w[i] > 0 else 0.0
    return C

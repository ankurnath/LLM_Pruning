def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    deg = dict(G.degree())
    sum_nei_deg = {v: 0 for v in nodes}
    for u, v in G.edges():
        du = deg[u]
        dv = deg[v]
        sum_nei_deg[u] += dv
        sum_nei_deg[v] += du
    feat = np.zeros(n, dtype=float)
    for i, v in enumerate(nodes):
        d = deg[v]
        feat[i] = sum_nei_deg[v] / d if d > 0 else 0.0
    return feat

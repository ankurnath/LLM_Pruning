def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    feat = np.zeros(n, dtype=float)
    wmap = {v: G.nodes[v].get('weight', 0.0) for v in nodes}
    if G.is_directed():
        for i, v in enumerate(nodes):
            deg = 0
            s = 0.0
            for u in G.successors(v):
                deg += 1
                s += wmap.get(u, 0.0)
            feat[i] = 0.0 if deg == 0 else s / deg
    else:
        for i, v in enumerate(nodes):
            deg = 0
            s = 0.0
            for u in G.neighbors(v):
                deg += 1
                s += wmap.get(u, 0.0)
            feat[i] = 0.0 if deg == 0 else s / deg
    return feat

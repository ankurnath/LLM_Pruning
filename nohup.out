import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_index = {node: i for i, node in enumerate(nodes)}
    node_weights = nx.get_node_attributes(G, 'weight')
    for i, n in enumerate(nodes):
        neighbors = list(G.neighbors(n))
        if not neighbors:
            feature[i] = 0.0
            continue
        neighbor_weights = [node_weights.get(nb, 0.0) for nb in neighbors]
        k = min(len(neighbor_weights), budget)
        top_k_weights = sorted(neighbor_weights, reverse=True)[:k]
        feature[i] = np.mean(top_k_weights) if top_k_weights else 0.0
    return feature

import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_indices = {node: i for i, node in enumerate(node_list)}
    scores = np.zeros(len(node_list))
    for node in node_list:
        neighbors = set(G.neighbors(node))
        neighbors.discard(node)
        covered_nodes = neighbors.union({node})
        redundant = covered_nodes.intersection(set(node_list))
        redundant_weight = sum(G.nodes[n]['weight'] for n in redundant)
        scores[node_indices[node]] = min(redundant_weight, budget)
    return scores

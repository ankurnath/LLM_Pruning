import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    coverage_gain = np.zeros(len(nodes))
    for idx, u in enumerate(nodes):
        gain = G.nodes[u]['weight']
        neighbors = set([u])
        for dist in range(1, budget+1):
            new_neighbors = set()
            for v in neighbors:
                new_neighbors.update(G.neighbors(v))
            new_neighbors -= neighbors
            gain += sum(G.nodes[v]['weight'] for v in new_neighbors)
            neighbors.update(new_neighbors)
        coverage_gain[idx] = gain
    return coverage_gain

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    vals = []
    for u in nodes:
        s = sum(G[u][v]['weight'] for v in G.neighbors(u))
        if budget > 0:
            vals.append(s / budget)
        else:
            vals.append(0.0)
    return np.array(vals)

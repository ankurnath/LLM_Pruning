import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    feature = np.zeros(len(node_list), dtype=float)
    node_set = set(node_list)
    for idx, u in enumerate(node_list):
        u_weight = G.nodes[u]['weight']
        neighbors = set(G.neighbors(u))
        unique_neighbors = neighbors - (node_set - {u})  # redundant, just neighbors
        unique_coverage = 0
        for v in neighbors:
            shared = [n for n in G.neighbors(v) if n != u and n in node_set]
            if not shared:
                unique_coverage += G.nodes[v]['weight']
        adjusted_score = (u_weight + unique_coverage) / (G.nodes[u]['weight'] + budget)
        feature[idx] = adjusted_score
    return feature

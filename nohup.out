def extract_feature(G):
    import numpy as np
    import networkx as nx
    if G.number_of_nodes() == 0:
        return np.array([], dtype=float)
    if G.is_directed():
        UG = G.to_undirected(reciprocal=False)
        clusters = nx.clustering(UG, weight=None)
        return np.array([clusters[n] for n in G.nodes()], dtype=float)
    else:
        clusters = nx.clustering(G, weight=None)
        return np.array([clusters[n] for n in G.nodes()], dtype=float)

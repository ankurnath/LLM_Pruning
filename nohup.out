import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    weights = {n: G.nodes[n].get('weight', 0.0) for n in G}
    arr = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        deg = G.degree(v)
        s = 0.0
        for nb in G.neighbors(v):
            s += weights.get(nb, 0.0)
        arr[i] = s / max(1, deg)
    return arr

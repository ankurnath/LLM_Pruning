def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    weights = np.array([G.nodes[v].get('weight', 0.0) for v in nodes], dtype=float)
    idx = {v: i for i, v in enumerate(nodes)}
    adj_indices = []
    for v in nodes:
        neighs = list(G.neighbors(v))
        adj_indices.append([idx[u] for u in neighs])
    feature = np.zeros(n, dtype=float)
    for i in range(n):
        neigh_i = adj_indices[i]
        if not neigh_i:
            feature[i] = 0.0
        else:
            wv = weights[i]
            s = 0.0
            for j in neigh_i:
                s += abs(wv - weights[j])
            feature[i] = s / len(neigh_i)
    return feature

import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_weights = np.array([G.nodes[n]['weight'] for n in node_list])
    neighbors = [set(G.neighbors(n)) for n in node_list]
    overlap_scores = np.zeros(len(node_list))
    for i, n in enumerate(node_list):
        coverage_n = set(neighbors[i])
        coverage_n.add(n)
        overlap_sum = 0
        for j, m in enumerate(node_list):
            if i == j:
                continue
            coverage_m = set(neighbors[j])
            coverage_m.add(m)
            overlap = len(coverage_n & coverage_m) / len(coverage_n | coverage_m)
            overlap_sum += overlap * G.nodes[m]['weight']
        overlap_scores[i] = overlap_sum
    if overlap_scores.max() > 0:
        overlap_scores_normalized = overlap_scores / overlap_scores.max()
    else:
        overlap_scores_normalized = overlap_scores
    return overlap_scores_normalized

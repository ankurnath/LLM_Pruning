import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    deg = dict(G.degree())
    val = {}
    for n in nodes:
        w = G.nodes[n].get('weight', 0.0)
        val[n] = deg[n] * w
    feats = []
    for v in nodes:
        total = 0.0
        count = 0
        for u in G.neighbors(v):
            total += val[u]
            count += 1
        if count == 0:
            feats.append(0.0)
        else:
            feats.append(total / count)
    return np.asarray(feats, dtype=float)

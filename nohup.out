def extract_feature(G):
    import numpy as np
    import networkx as nx

    if G.number_of_nodes() == 0:
        return np.array([], dtype=float)

    try:
        pr_values = nx.pagerank_numpy(G, weight='weight')
        pr_values = np.asarray(pr_values, dtype=float)
        max_pr = float(np.max(pr_values)) if pr_values.size > 0 else 0.0
        if max_pr == 0.0:
            return np.zeros(G.number_of_nodes(), dtype=float)
        return pr_values / max_pr
    except Exception:
        pr = nx.pagerank(G, weight='weight')
        max_pr = max(pr.values()) if pr else 0.0
        if max_pr == 0.0:
            return np.zeros(G.number_of_nodes(), dtype=float)
        order = list(G.nodes())
        return np.array([pr[n] / max_pr for n in order], dtype=float)

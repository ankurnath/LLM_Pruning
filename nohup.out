import numpy as np
import networkx as nx

def extract_feature(G, budget):
    node_list = list(G.nodes())
    values = []
    for n in node_list:
        total = 0
        for m in G.nodes():
            if n == m:
                continue
            try:
                length = nx.shortest_path_length(G, n, m, weight='weight')
                if length <= budget:
                    total += G.nodes[m]['weight']
            except nx.NetworkXNoPath:
                continue
        values.append(total)
    return np.array(values)

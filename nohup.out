def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    degs = np.array([G.out_degree(n) for n in nodes], dtype=float)
    weights = np.array([G.nodes[n].get('weight', 0.0) for n in nodes], dtype=float)
    with np.errstate(divide='ignore', invalid='ignore'):
        ratios = degs / weights
    ratios[~np.isfinite(ratios)] = np.nan
    return ratios

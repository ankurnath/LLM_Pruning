def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    weights = {u: G.nodes[u]['weight'] for u in G}
    out = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        if G.is_directed():
            nbrs = G.successors(v)
        else:
            nbrs = G.neighbors(v)
        total = 0.0
        count = 0
        for u in nbrs:
            total += weights[u]
            count += 1
        out[i] = total / count if count > 0 else 0.0
    return out

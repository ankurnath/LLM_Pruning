import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    for i, u in enumerate(nodes):
        node_weight = G.nodes[u]['weight']
        total_neighbor_cost = sum(G.edges[u, v]['weight'] for v in G.neighbors(u))
        if total_neighbor_cost == 0:
            feature[i] = 0.0
        else:
            feature[i] = min(budget, node_weight) / total_neighbor_cost
    return feature

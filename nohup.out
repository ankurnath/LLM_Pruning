import numpy as np
import networkx as nx

def extract_feature(G, budget):
    lengths = dict(nx.all_pairs_dijkstra_path_length(G, weight='weight'))
    nodes = list(G.nodes())
    res = []
    for u in nodes:
        s = 0
        for v in nodes:
            if u != v:
                dist = lengths[u].get(v, float('inf'))
                if dist <= budget and dist > 0:
                    s += 1.0 / dist
        res.append(s)
    return np.array(res)

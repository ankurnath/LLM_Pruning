import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_weights = np.array([G.nodes[n]['weight'] for n in node_list])
    neighbors = {n: set(G.neighbors(n)) | {n} for n in node_list}
    covered = [neighbors[n] for n in node_list]
    total_unique = []
    for i, n in enumerate(node_list):
        unique = covered[i].copy()
        for j, m in enumerate(node_list):
            if i == j or node_weights[j] > budget:
                continue
            unique -= covered[j]
        total_unique.append(len(unique))
    normalized = np.array(total_unique, dtype=float) / len(G)
    return normalized

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_index = {n: i for i, n in enumerate(nodes)}
    feature = np.zeros(len(nodes))
    for i, n in enumerate(nodes):
        two_hop = set()
        for nbr in G.neighbors(n):
            two_hop.add(nbr)
            for nbr2 in G.neighbors(nbr):
                two_hop.add(nbr2)
        gain = sum(G.nodes[u]['weight'] for u in two_hop)
        feature[i] = min(gain, budget)
    return feature

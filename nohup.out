import numpy as np

def extract_feature(G):
    succs = {n: set(G.successors(n)) for n in G}
    nodes = list(G.nodes())
    features = np.zeros(len(nodes), dtype=float)
    for idx, v in enumerate(nodes):
        S = succs[v]
        k = len(S)
        if k <= 1:
            features[idx] = 0.0
            continue
        actual = 0
        for a in S:
            inter = len(succs[a] & S)
            if a in succs[a] and a in S:
                inter -= 1
            actual += max(0, inter)
        denom = k * (k - 1)
        features[idx] = actual / denom if denom > 0 else 0.0
    return features

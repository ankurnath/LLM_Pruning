def extract_feature(G):
    import numpy as np
    deg = dict(G.degree())
    nodes = list(G.nodes())
    out = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        d_v = deg.get(v, 0)
        if d_v == 0:
            out[i] = 0.0
        else:
            s = 0.0
            for u in G.neighbors(v):
                s += deg.get(u, 0)
            out[i] = s / d_v
    return out

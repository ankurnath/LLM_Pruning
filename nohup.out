def extract_feature(G):
    import numpy as np
    n = G.number_of_nodes()
    result = np.zeros(n, dtype=float)
    nodes = list(G.nodes())
    for i, v in enumerate(nodes):
        if G.is_directed():
            out_neighbors = list(G.successors(v))
        else:
            out_neighbors = list(G.neighbors(v))
        if not out_neighbors:
            result[i] = 0.0
            continue
        denom_edges = 0.0
        all_have_edge_weight = True
        for w in out_neighbors:
            w_e = G[v][w].get('weight', None)
            if w_e is None:
                all_have_edge_weight = False
                break
            denom_edges += w_e
        if all_have_edge_weight:
            if denom_edges == 0.0:
                result[i] = 0.0
            else:
                s = 0.0
                for w in out_neighbors:
                    w_e = G[v][w].get('weight', 1.0)
                    s += w_e / denom_edges
                result[i] = s
        else:
            denom_nodes = 0.0
            for w in out_neighbors:
                denom_nodes += G.nodes[w].get('weight', 0.0)
            if denom_nodes == 0.0:
                result[i] = 0.0
            else:
                s = 0.0
                for w in out_neighbors:
                    s += G.nodes[w].get('weight', 0.0) / denom_nodes
                result[i] = s
    return result

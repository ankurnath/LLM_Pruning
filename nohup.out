import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    features = []
    for u in node_list:
        u_cov = set([u]) | set(G.neighbors(u))
        overlap_sum = 0
        for v in node_list:
            if u == v:
                continue
            v_cov = set([v]) | set(G.neighbors(v))
            overlap = u_cov & v_cov
            if len(v_cov) > 0:
                overlap_sum += len(overlap) / len(v_cov)
        ratio = overlap_sum / (len(node_list) - 1) if len(node_list) > 1 else 0
        features.append(ratio)
    return np.array(features)

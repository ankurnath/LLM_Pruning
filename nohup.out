def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    idx = {nodes[i]: i for i in range(n)}
    weights = np.zeros(n, dtype=float)
    for i, v in enumerate(nodes):
        weights[i] = G.nodes[v].get('weight', 0.0)
    result = np.zeros(n, dtype=float)
    for i, v in enumerate(nodes):
        deg = G.degree(v)
        if deg == 0:
            result[i] = 0.0
        else:
            s = 0.0
            for nb in G.neighbors(v):
                s += weights[idx[nb]]
            result[i] = s / deg
    return result

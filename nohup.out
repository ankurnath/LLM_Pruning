def extract_feature(G):
    import numpy as np
    weight = {n: d.get('weight', 0) for n, d in G.nodes(data=True)}
    nodes = list(G.nodes())
    out_vals = []
    if G.is_directed():
        for v in nodes:
            max_w = max((weight[u] for u in G.successors(v)), default=np.nan)
            out_vals.append(max_w)
    else:
        for v in nodes:
            max_w = max((weight[u] for u in G.neighbors(v)), default=np.nan)
            out_vals.append(max_w)
    return np.asarray(out_vals, dtype=float)

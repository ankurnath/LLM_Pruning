import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    n = len(nodes)
    idx_map = {node: i for i, node in enumerate(nodes)}
    features = np.zeros(n)
    for i, node in enumerate(nodes):
        neighbors = set(G.neighbors(node))
        two_hop = set()
        for nbr in neighbors:
            two_hop.update(G.neighbors(nbr))
        coverage = neighbors | two_hop | {node}
        gain = sum(G.nodes[v]['weight'] for v in coverage)
        features[i] = min(gain, budget)
    return features

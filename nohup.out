def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    deg = dict(G.degree())
    out = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        neigh = G.neighbors(v)
        dvals = [deg[u] for u in neigh]
        if len(dvals) == 0:
            out[i] = 0.0
        else:
            out[i] = float(np.std(dvals, ddof=0))
    return out

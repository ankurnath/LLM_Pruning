import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    n = len(node_list)
    weights = np.array([G.nodes[node]['weight'] for node in node_list])
    core_numbers = nx.core_number(G)
    core_arr = np.array([core_numbers[node] for node in node_list])
    idx_map = {node: i for i, node in enumerate(node_list)}
    res = np.zeros(n)
    for i, node in enumerate(node_list):
        max_gap = 0
        for neighbor in G.neighbors(node):
            gap = abs(core_arr[i] - core_arr[idx_map[neighbor]])
            if gap > max_gap:
                max_gap = gap
        res[i] = max_gap
    return res

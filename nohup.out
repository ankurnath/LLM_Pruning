import numpy as np
import networkx as nx

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_index = {n: i for i, n in enumerate(node_list)}
    weights = nx.get_node_attributes(G, 'weight')
    n = len(node_list)
    coverage = [set([v]) for v in node_list]
    feature = np.zeros(n, dtype=float)
    for idx, v in enumerate(node_list):
        neighbors = list(G.neighbors(v))
        if not neighbors:
            feature[idx] = 0.0
            continue
        avg_cov = 0.0
        for u in neighbors:
            u_nbrs = set(G.neighbors(u))
            unique_cov = (u_nbrs - set([v])) - set(neighbors)
            total_weight = sum(weights.get(w, 0) for w in unique_cov)
            avg_cov += total_weight / budget
        feature[idx] = avg_cov / len(neighbors)
    return feature

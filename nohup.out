import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_sets = []
    for n in nodes:
        neigh = set([n]) | set(G.neighbors(n))
        node_sets.append(neigh)
    counts = np.zeros(len(nodes))
    for i, s in enumerate(node_sets):
        union_set = set.union(*(node_sets[j] for j in range(len(nodes)) if j != i))
        unique_nodes = s - union_set
        unique_weight = sum(G.nodes[u]['weight'] for u in unique_nodes)
        counts[i] = unique_weight
    counts = np.minimum(counts, budget)
    return counts

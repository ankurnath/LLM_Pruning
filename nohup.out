import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_indices = {n: i for i, n in enumerate(node_list)}
    neighbor_sets = {n: set(G.neighbors(n)) for n in node_list}
    node_weights = {n: G.nodes[n]['weight'] for n in node_list}
    exclusive_coverage = np.zeros(len(node_list))
    for idx, n in enumerate(node_list):
        exclusive_neighbors = neighbor_sets[n] - set().union(*(neighbor_sets[m] for m in node_list if m != n))
        score = node_weights[n]
        for m in exclusive_neighbors:
            if 'weight' in G.nodes[m]:
                score += G.nodes[m]['weight']
        if score > budget:
            score = budget
        exclusive_coverage[idx] = score
    return exclusive_coverage

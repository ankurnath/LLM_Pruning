bor_exclusive_weighted_efficiency = []\n    for node in nodes:\n        neighbors = set(G.neighbors(node))\n        neighbor_weights = [G.nodes[n]['weight'] for n in neighbors if n not in [node]]\n        s = sum(neighbor_weights)\n        exclusive = max(0, budget - G.nodes[node]['weight'])\n        efficiency = s / exclusive if exclusive > 0 else 0\n        neighbor_exclusive_weighted_efficiency.append(efficiency)\n    return np.array(neighbor_exclusive_weighted_efficiency)", 'centrality_gain_normalized': "import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    centrality = nx.degree_centrality(G)\n    weights = np.array([G.nodes[n]['weight'] for n in nodes])\n    cent = np.array([centrality[n] for n in nodes])\n    gain = cent * weights\n    budget = max(budget, 1)\n    gain_norm = gain / budget\n    return gain_norm"}, 'ratio': 1.0, 'size_reduction': 0.7055276381909548, 'multiplication': 0.7055276381909548}

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    second_order_degree = []
    for v in nodes:
        visited = set([v])
        first_neighbors = set(G.neighbors(v))
        visited.update(first_neighbors)
        second_neighbors = set()
        for u in first_neighbors:
            second_neighbors.update(n for n in G.neighbors(u) if n not in visited)
        count = 0
        for n in second_neighbors:
            w = G.nodes[n].get('weight', 1)
            if w <= budget:
                count += 1
        second_order_degree.append(count)
    return np.array(second_order_degree)

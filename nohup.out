import numpy as np
import networkx as nx

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_idx = {n: i for i, n in enumerate(nodes)}
    for i, u in enumerate(nodes):
        covered = set([u])
        selected_weight = G.nodes[u].get('weight', 0)
        neighbors = set(G.neighbors(u))
        covered.update(neighbors)
        total_weight = selected_weight
        if total_weight > budget:
            feature[i] = 0
            continue
        candidates = neighbors - set([u])
        used = set([u])
        while total_weight < budget and candidates:
            best = None
            best_gain = -1
            for v in candidates:
                new_nodes = set(G.neighbors(v)) | set([v])
                gain = len(new_nodes - covered)
                weight_v = G.nodes[v].get('weight', 0)
                if total_weight + weight_v <= budget and gain > best_gain:
                    best_gain = gain
                    best = v
            if best is None or best_gain <= 0:
                break
            used.add(best)
            old_total = total_weight
            total_weight += G.nodes[best].get('weight', 0)
            covered.update(set(G.neighbors(best)) | set([best]))
            candidates = (candidates | (set(G.neighbors(best)) - used)) - used
        feature[i] = len(covered)
    return feature

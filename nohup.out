import numpy as np
import networkx as nx

def extract_feature(G, budget):
    core_numbers = nx.core_number(G)
    nodes = list(G.nodes())
    feature = []
    for n in nodes:
        neighbors = list(G.neighbors(n))
        if len(neighbors) > budget:
            neighbors = neighbors[:budget]
        if neighbors:
            avg = np.mean([core_numbers[nb] for nb in neighbors])
        else:
            avg = 0.0
        feature.append(avg)
    return np.array(feature)

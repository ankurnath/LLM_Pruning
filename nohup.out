import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_weights = {n: G.nodes[n]['weight'] for n in nodes}
    feature = []
    for n in nodes:
        count = 0
        neighbor_set = set([n])
        for neighbor in G.neighbors(n):
            if node_weights[neighbor] <= budget:
                neighbor_set.add(neighbor)
        for m in nodes:
            if m == n:
                continue
            overlap = len(neighbor_set & set([m] + list(G.neighbors(m))))
            if overlap > 0:
                count += 1
        feature.append(count)
    return np.array(feature)

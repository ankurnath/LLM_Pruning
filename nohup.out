import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    feature = np.zeros(len(node_list))
    node_idx = {n: i for i, n in enumerate(node_list)}
    for n in node_list:
        visited = set([n])
        first_hop = set(G.neighbors(n))
        visited |= first_hop
        second_hop = set()
        for nb in first_hop:
            second_hop |= set(G.neighbors(nb))
        second_hop -= visited
        total_nodes = first_hop | second_hop
        nodes_within_budget = []
        for target in total_nodes:
            try:
                path = nx.shortest_path(G, source=n, target=target)
                path_weight = sum(G.nodes[u]['weight'] for u in path)
                if path_weight <= budget:
                    nodes_within_budget.append(target)
            except:
                continue
        feature[node_idx[n]] = len(nodes_within_budget)
    return feature

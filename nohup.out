import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feat = np.zeros(len(nodes))
    node_idx = {n: i for i, n in enumerate(nodes)}
    for i, n in enumerate(nodes):
        covered = set([n])
        covered.update(G.neighbors(n))
        covered_weight = sum(G.nodes[v]['weight'] for v in covered)
        if covered_weight > budget:
            feat[i] = 0
        else:
            gain = 0
            for u in G.neighbors(n):
                u_neighbors = set([u])
                u_neighbors.update(G.neighbors(u))
                new_cov = u_neighbors - covered
                gain = max(gain, sum(G.nodes[v]['weight'] for v in new_cov))
            feat[i] = gain
    return feat

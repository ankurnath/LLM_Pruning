def extract_feature(G):
    import numpy as np
    weights = {n: G.nodes[n].get('weight', 0) for n in G}
    feats = []
    for v in G:
        max_w = 0
        for u in G.neighbors(v):
            wu = weights.get(u, 0)
            if wu > max_w:
                max_w = wu
        feats.append(max_w)
    return np.asarray(feats)

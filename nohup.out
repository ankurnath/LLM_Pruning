import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    res = np.zeros(len(nodes), dtype=float)
    directed = G.is_directed()
    for idx, v in enumerate(nodes):
        s = 0.0
        if directed:
            neigh = G.successors(v)
        else:
            neigh = G.neighbors(v)
        for u in neigh:
            s += G.nodes[u].get('weight', 0.0)
        res[idx] = s
    return res

import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    n = len(nodes)
    idx = {node: i for i, node in enumerate(nodes)}
    feat = np.zeros(n, dtype=float)
    if n == 0:
        return feat
    directed = G.is_directed()
    if G.is_multigraph():
        if directed:
            for u, v, key, data in G.edges(keys=True, data=True):
                p = data.get('p_vu', data.get('weight', 0.0))
                feat[idx[u]] += p
        else:
            for u, v, key, data in G.edges(keys=True, data=True):
                p = data.get('p_vu', data.get('weight', 0.0))
                feat[idx[u]] += p
                feat[idx[v]] += p
    else:
        if directed:
            for u, v, data in G.edges(data=True):
                p = data.get('p_vu', data.get('weight', 0.0))
                feat[idx[u]] += p
        else:
            for u, v, data in G.edges(data=True):
                p = data.get('p_vu', data.get('weight', 0.0))
                feat[idx[u]] += p
                feat[idx[v]] += p
    return feat

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_idx = {n: i for i, n in enumerate(nodes)}
    for i, u in enumerate(nodes):
        covered = set([u])
        for v in G.neighbors(u):
            covered.add(v)
            for w in G.neighbors(v):
                covered.add(w)
        gain = 0
        for n in covered:
            gain += G.nodes[n]['weight']
        gain = min(gain, budget)
        feature[i] = gain
    return feature

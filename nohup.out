import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.empty(len(nodes))
    for i, node in enumerate(nodes):
        neighbors = [n for n in G.neighbors(node)]
        if budget is not None:
            neighbors = neighbors[:budget]
        if neighbors:
            neighbor_weights = [G.nodes[n]['weight'] for n in neighbors]
            feature[i] = np.std(neighbor_weights)
        else:
            feature[i] = 0.0
    return feature

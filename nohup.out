import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(node_list)}
    total_weights = np.zeros(len(node_list))
    two_hop_weights = np.zeros(len(node_list))
    for idx, node in enumerate(node_list):
        visited = set([node])
        queue = [(node, 0)]
        while queue:
            current, depth = queue.pop(0)
            if depth >= 2:
                continue
            for neighbor in G.neighbors(current):
                if neighbor not in visited:
                    visited.add(neighbor)
                    if depth + 1 < 2:
                        queue.append((neighbor, depth + 1))
        visited.remove(node)
        for n in visited:
            two_hop_weights[idx] += G.nodes[n]['weight']
    for idx, node in enumerate(node_list):
        total_weights[idx] = np.sum([G.nodes[n]['weight'] for n in G.nodes()])
    two_hop_coverage_ratio = np.minimum(two_hop_weights, budget) / np.minimum(total_weights, budget)
    return two_hop_coverage_ratio

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    idx = {node: i for i, node in enumerate(nodes)}
    w = np.array([G.nodes[node].get('weight', 0.0) for node in nodes], dtype=float)
    feat = np.zeros(n, dtype=float)
    for v in nodes:
        i = idx[v]
        s = 0.0
        for nb in G.neighbors(v):
            s += w[idx[nb]]
        feat[i] = s
    return feat

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    weights = {n: G.nodes[n].get('weight', 0.0) for n in nodes}
    feat = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        s = 0.0
        for u in G.neighbors(v):
            s += weights[u]
        feat[i] = s
    return feat

def extract_feature(G):
    import numpy as np
    import networkx as nx
    nodes = list(G.nodes())
    n = len(nodes)
    triangles = nx.triangles(G)
    deg = dict(G.degree())
    out = np.zeros(n, dtype=float)
    for i, v in enumerate(nodes):
        d = deg.get(v, 0)
        if d < 2:
            out[i] = 0.0
        else:
            t = triangles.get(v, 0)
            out[i] = (2.0 * t) / (d * (d - 1))
    return out

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    degrees = dict(G.degree())
    weights = nx.get_node_attributes(G, 'weight')
    feat = []
    for n in nodes:
        neighbors = list(G.neighbors(n))
        if not neighbors:
            feat.append(0.0)
            continue
        ratios = []
        for nbr in neighbors:
            deg = degrees[nbr]
            if deg == 0:
                ratios.append(0.0)
            else:
                ratios.append(weights.get(nbr,0.0)/deg)
        avg_ratio = sum(ratios)/len(ratios)
        feat.append(avg_ratio)
    return np.array(feat)

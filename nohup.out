def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.array([], dtype=float)
    alpha = 0.05
    beta = budget
    factor = beta / n
    degs = np.array([G.degree(v) for v in nodes], dtype=float)
    w = factor * (degs - alpha)
    w = np.maximum(w, 1.0)
    return w

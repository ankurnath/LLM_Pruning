import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature_values = np.zeros(len(nodes))
    node_index = {node: i for i, node in enumerate(nodes)}
    weights = nx.get_node_attributes(G, 'weight')
    for node in nodes:
        node_weight = weights[node]
        neighbors = G.neighbors(node)
        overlap = 0
        for nbr in neighbors:
            nbr_weight = weights[nbr]
            min_weight = min(node_weight, nbr_weight)
            overlap += min_weight
        feature_values[node_index[node]] = min(overlap, budget)
    return feature_values

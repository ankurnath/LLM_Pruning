import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    values = np.zeros(len(nodes))
    node_idx = {n: i for i, n in enumerate(nodes)}
    weights = nx.get_node_attributes(G, 'weight')
    for i, n in enumerate(nodes):
        coverage = 0
        for nbr in G.neighbors(n):
            coverage += weights.get(nbr, 0)
            for nbr2 in G.neighbors(nbr):
                if nbr2 != n:
                    coverage += weights.get(nbr2, 0)
        if budget > 0:
            coverage = min(coverage, budget)
        values[i] = coverage
    return values

def extract_feature(G):
    import numpy as np
    weights = {}
    for n in G:
        weights[n] = G.nodes[n].get('weight', 0.0)
    nodes = list(G.nodes())
    result = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        neigh = G.neighbors(v)
        wlist = [weights[u] for u in neigh]
        if len(wlist) <= 1:
            result[i] = 0.0
        else:
            result[i] = float(np.std(np.array(wlist), ddof=0))
    return result

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    weights = {}
    for v, data in G.nodes(data=True):
        weights[v] = data.get('weight', 0.0)
    feature = np.empty(n, dtype=float)
    if G.is_directed():
        get_out = lambda x: G.successors(x)
    else:
        get_out = lambda x: G.neighbors(x)
    for i, v in enumerate(nodes):
        wv = weights.get(v, 0.0)
        total = 0.0
        cnt = 0
        for u in get_out(v):
            wu = weights.get(u, 0.0)
            total += wu
            cnt += 1
        avg = total / cnt if cnt > 0 else 0.0
        feature[i] = wv - avg
    return feature

def extract_feature(G):
    import numpy as np
    import networkx as nx

    nodes = list(G.nodes())
    total = 0.0
    weights = {}
    for n in nodes:
        w = G.nodes[n].get('weight', 0.0)
        weights[n] = w
        total += w

    if total > 0.0:
        personalization = {n: weights[n] / total for n in nodes}
        pr = nx.pagerank(G, alpha=0.85, personalization=personalization, weight=None)
    else:
        pr = nx.pagerank(G, alpha=0.85, weight=None)

    return np.array([pr[n] for n in nodes])

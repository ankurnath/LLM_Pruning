import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    features = np.zeros(len(nodes))
    weights = nx.get_node_attributes(G, 'weight')
    for i, node in enumerate(nodes):
        neighbors = list(G.neighbors(node))
        if budget is not None:
            neighbors = neighbors[:budget]
        neighbor_weights = [weights[n] for n in neighbors if n in weights]
        if len(neighbor_weights) > 1:
            features[i] = np.var(neighbor_weights)
        else:
            features[i] = 0.0
    return features

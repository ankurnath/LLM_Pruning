def extract_feature(G):
    import numpy as np
    import networkx as nx
    if G.number_of_nodes() == 0:
        return np.array([], dtype=int)
    core_num = nx.core_number(G, weight=None)
    nodes = list(G.nodes())
    return np.array([core_num[n] for n in nodes], dtype=int)

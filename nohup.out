import numpy as np

def extract_feature(G):
    epsilon = 0.01
    nodes = list(G.nodes())
    feat = np.empty(len(nodes), dtype=float)
    weights = {node: G.nodes[node].get('weight', 0.0) for node in nodes}
    directed = G.is_directed()

    for i, v in enumerate(nodes):
        if directed:
            nbrs = list(G.successors(v))
        else:
            nbrs = list(G.neighbors(v))
        if not nbrs:
            sum_p = 0.0
        else:
            total = 0.0
            for u in nbrs:
                total += weights.get(u, 0.0)
            if total > 0.0:
                s = 0.0
                for u in nbrs:
                    s += weights.get(u, 0.0) / total
                sum_p = s
            else:
                sum_p = 0.0
        feat[i] = max(sum_p, epsilon)

    return feat

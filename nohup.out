def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.zeros(0, dtype=float)
    weights = {nid: G.nodes[nid].get('weight', 0.0) for nid in nodes}
    deg_map = dict(G.out_degree()) if G.is_directed() else dict(G.degree())
    feature = np.zeros(n, dtype=float)
    neigh_iter = G.successors if G.is_directed() else G.neighbors
    for idx, v in enumerate(nodes):
        deg = deg_map.get(v, 0)
        s = 0.0
        for u in neigh_iter(v):
            s += weights.get(u, 0.0)
        feature[idx] = s / max(1, deg)
    return feature

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.array([], dtype=float)
    degs = np.fromiter((G.out_degree(v) for v in nodes), dtype=float, count=n)
    max_out_deg = degs.max() if degs.size > 0 else 0.0
    if max_out_deg == 0.0:
        deg_norm = np.zeros_like(degs)
    else:
        deg_norm = degs / max_out_deg
    weights = np.fromiter((float(G.nodes[v].get('weight', 0.0)) for v in nodes), dtype=float, count=n)
    max_w = weights.max() if weights.size > 0 else 0.0
    if max_w == 0.0:
        weight_norm = np.zeros_like(weights)
    else:
        weight_norm = weights / max_w
    denom = deg_norm + weight_norm + 1e-12
    feature = deg_norm / denom
    return feature

import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    deg = dict(G.degree())
    feats = []
    for v in nodes:
        neighbor_degrees = [deg[u] for u in G.neighbors(v)]
        if not neighbor_degrees:
            feats.append(0.0)
        else:
            feats.append(float(np.var(neighbor_degrees, ddof=0)))
    return np.array(feats, dtype=float)

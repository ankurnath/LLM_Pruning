import numpy as np
import networkx as nx

def extract_feature(G):
    has_edge_weight = False
    for _, _, data in G.edges(data=True):
        if 'weight' in data:
            has_edge_weight = True
            break
    weight_attr = 'weight' if has_edge_weight else None
    try:
        centrality = nx.katz_centrality(G, alpha=None, beta=1.0, normalized=True, weight=weight_attr)
    except TypeError:
        centrality = nx.katz_centrality(G, alpha=0.1, beta=1.0, normalized=True, weight=weight_attr)
    nodes = list(G.nodes())
    return np.array([centrality[n] for n in nodes], dtype=float)

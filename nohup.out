import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    res = []
    for u in nodes:
        neighbors = set(G.neighbors(u))
        covered = set()
        for v in neighbors:
            covered.update(G.neighbors(v))
        covered.discard(u)
        unique_covered = covered - neighbors
        weights = [G.nodes[w]['weight'] for w in unique_covered]
        if weights and budget > 0:
            weights = sorted(weights, reverse=True)
            s = 0
            total = 0
            for w in weights:
                if s + 1 > budget:
                    break
                s += 1
                total += w
            res.append(total)
        else:
            res.append(0)
    return np.array(res)

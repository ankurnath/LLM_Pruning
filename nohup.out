def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    deg_map = dict(G.out_degree(nodes))
    feats = []
    for n in nodes:
        w = G.nodes[n]['weight']
        d = deg_map[n]
        feats.append(d / w if w != 0 else float('nan'))
    return np.array(feats, dtype=float)

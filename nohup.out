def extract_feature(G):
    import numpy as np
    n = G.number_of_nodes()
    order = list(G.nodes())
    idx = {node: i for i, node in enumerate(order)}
    feature = np.zeros(n, dtype=float)

    if G.is_directed():
        sum_out = {}
        for v in order:
            s = 0.0
            for _, _, data in G.out_edges(v, data=True):
                s += data.get('weight', 1.0)
            sum_out[v] = s
        for v in order:
            denom = sum_out[v]
            val = 0.0
            if denom != 0.0:
                for _, _, data in G.out_edges(v, data=True):
                    val += data.get('weight', 1.0) / denom
            feature[idx[v]] = val
    else:
        sum_out = {}
        for v in order:
            s = 0.0
            for _, _, data in G.edges(v, data=True):
                s += data.get('weight', 1.0)
            sum_out[v] = s
        for v in order:
            denom = sum_out[v]
            val = 0.0
            if denom != 0.0:
                for _, _, data in G.edges(v, data=True):
                    val += data.get('weight', 1.0) / denom
            feature[idx[v]] = val

    return feature

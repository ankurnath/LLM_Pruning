def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    result = np.zeros(len(nodes), dtype=float)
    if G.is_directed():
        out_deg = dict(G.out_degree())
        for i, v in enumerate(nodes):
            s = 0.0
            cnt = 0
            for u in G.successors(v):
                s += out_deg.get(u, 0)
                cnt += 1
            result[i] = (s / cnt) if cnt > 0 else 0.0
    else:
        out_deg = dict(G.degree())
        for i, v in enumerate(nodes):
            s = 0.0
            cnt = 0
            for u in G.neighbors(v):
                s += out_deg.get(u, 0)
                cnt += 1
            result[i] = (s / cnt) if cnt > 0 else 0.0
    return result

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_idx = {n: i for i, n in enumerate(nodes)}
    for i, n in enumerate(nodes):
        first_order = set(G.neighbors(n))
        second_order = set()
        for nb in first_order:
            second_order.update(G.neighbors(nb))
        second_order.discard(n)
        second_order -= first_order
        gain = sum(G.nodes[v]['weight'] for v in second_order)
        if budget > 0:
            gain = min(gain, budget)
        feature[i] = gain
    return feature

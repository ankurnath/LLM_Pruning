import numpy as np

def extract_feature(G):
    deg_map = dict(G.degree())
    nodes = list(G.nodes())
    feat = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        s = 0.0
        k = 0
        for u in G.neighbors(v):
            k += 1
            s += deg_map.get(u, 0)
        feat[i] = 0.0 if k == 0 else s / k
    return feat

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    normalized_cov = np.zeros(len(nodes))
    total_nodes = len(G)
    for idx, n in enumerate(nodes):
        neighbors = set(G.neighbors(n))
        unique_cov = neighbors - {nbr for nbr in nodes if nbr != n and n in G.neighbors(nbr)}
        unique_coverage = len(unique_cov)
        normalized_cov[idx] = unique_coverage / total_nodes if total_nodes > 0 else 0.0
    return normalized_cov

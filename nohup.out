import numpy as np
import networkx as nx

def extract_feature(G, budget):
    nodes = list(G.nodes())
    cliques = list(nx.find_cliques(G))
    clique_sets = [set(c) for c in cliques]
    node_indices = {n: i for i, n in enumerate(nodes)}
    result = np.zeros(len(nodes), dtype=float)

    for i, u in enumerate(nodes):
        neighbors = set(G.neighbors(u))
        total_neighbors = len(neighbors)
        if total_neighbors == 0:
            result[i] = 0.0
            continue
        # Find if each neighbor shares a clique with u s.t. clique's total 'weight' <= budget
        count = 0
        for v in neighbors:
            for c in clique_sets:
                if u in c and v in c:
                    clique_weight = sum(G.nodes[n]['weight'] for n in c)
                    if clique_weight <= budget:
                        count += 1
                        break
        result[i] = count / total_neighbors
    return result

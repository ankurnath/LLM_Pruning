def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    result = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        s = 0.0
        s2 = 0.0
        m = 0
        for u in G.neighbors(v):
            w = G.nodes[u].get('weight', 0.0)
            s += w
            s2 += w * w
            m += 1
        if m > 0:
            mean = s / m
            var = s2 / m - mean * mean
            if var < 0 and var > -1e-12:
                var = 0.0
            result[i] = var
        else:
            result[i] = 0.0
    return result

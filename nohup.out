import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(nodes)}
    feature = np.zeros(len(nodes), dtype=float)
    for i, u in enumerate(nodes):
        nbr1 = set(G.neighbors(u))
        nbr2 = set()
        for v in nbr1:
            nbr2.update(G.neighbors(v))
        two_hop = nbr2 | nbr1 | {u}
        unique_two_hop = two_hop - {u}
        numerator = sum(G.nodes[v]['weight'] for v in unique_two_hop)
        denominator = sum(G.nodes[v]['weight'] for v in G.nodes)
        ratio = numerator / denominator if denominator > 0 else 0.0
        feature[i] = min(ratio, budget / denominator) if denominator > 0 else 0.0
    return feature

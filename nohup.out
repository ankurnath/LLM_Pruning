def extract_feature(G):
    import numpy as np
    import networkx as nx
    node_order = list(G.nodes())
    n = len(node_order)
    if n == 0:
        return np.zeros((0,), dtype=float)
    clusters = nx.clustering(G, weight=None)
    out = np.empty(n, dtype=float)
    for i, v in enumerate(node_order):
        out[i] = clusters.get(v, 0.0)
    return out

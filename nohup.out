import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(node_list)}
    n = len(node_list)
    feature = np.zeros(n)
    for i, v in enumerate(node_list):
        visited = set([v])
        queue = [(v, 0)]
        coverage = 0
        while queue:
            u, dist = queue.pop(0)
            if dist > 2:
                continue
            if dist > 0 and u not in visited:
                coverage += G.nodes[u].get('weight', 0)
            visited.add(u)
            if dist < 2:
                for nbr in G.neighbors(u):
                    if nbr not in visited:
                        queue.append((nbr, dist + 1))
        if coverage > budget:
            coverage = budget
        feature[i] = coverage
    return feature

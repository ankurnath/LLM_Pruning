import numpy as np
import networkx as nx

def extract_feature(G):
    if G.is_multigraph():
        UG = nx.Graph()
        UG.add_nodes_from(G.nodes())
        UG.add_edges_from(G.edges())
    else:
        UG = G
    cc = nx.clustering(UG, weight=None)
    order = list(G.nodes())
    return np.array([cc[n] for n in order], dtype=float)

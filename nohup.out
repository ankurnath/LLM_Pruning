import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    rel_deg = np.zeros(len(nodes))
    node_index = {n: i for i, n in enumerate(nodes)}
    for i, u in enumerate(nodes):
        own_deg = 0
        for v in G.neighbors(u):
            edge_data = G.get_edge_data(u, v)
            own_deg += edge_data['weight'] if 'weight' in edge_data else 1
        if own_deg == 0:
            rel_deg[i] = 0
            continue
        neighbor_deg_sum = 0
        for v in G.neighbors(u):
            deg_v = 0
            for w in G.neighbors(v):
                edge_data = G.get_edge_data(v, w)
                deg_v += edge_data['weight'] if 'weight' in edge_data else 1
            neighbor_deg_sum += deg_v
        num_neighbors = len(list(G.neighbors(u)))
        if num_neighbors == 0:
            rel_deg[i] = 0
            continue
        avg_neighbor_deg = neighbor_deg_sum / num_neighbors
        rel_deg[i] = own_deg / avg_neighbor_deg if avg_neighbor_deg != 0 else 0
    if budget > 0:
        rel_deg = np.clip(rel_deg, 0, budget)
    return rel_deg

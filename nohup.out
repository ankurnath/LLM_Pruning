import numpy as np

def extract_feature(G):
    node_order = list(G.nodes())
    n = len(node_order)
    feature = np.zeros(n, dtype=float)
    for i, v in enumerate(node_order):
        if G.is_directed():
            nbrs = G.successors(v)
        else:
            nbrs = G.neighbors(v)
        s = 0.0
        cnt = 0
        for u in nbrs:
            w = G.nodes[u].get('weight', 0.0)
            s += w
            cnt += 1
        feature[i] = s / cnt if cnt > 0 else 0.0
    return feature

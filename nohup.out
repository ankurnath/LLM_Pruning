import numpy as np

def extract_feature(G):
    weights = {n: G.nodes[n].get('weight', 0) for n in G}
    node_order = list(G)
    feat = np.zeros(len(node_order), dtype=float)
    for i, v in enumerate(node_order):
        deg = G.degree(v)
        if deg == 0:
            feat[i] = 0.0
        else:
            wv = weights[v]
            cnt = 0
            for u in G.neighbors(v):
                if weights[u] > wv:
                    cnt += 1
            feat[i] = cnt / deg
    return feat

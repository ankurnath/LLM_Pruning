import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    result = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        nbrs = list(G.neighbors(v))
        if not nbrs:
            result[i] = 0.0
            continue
        weights = np.array([G.nodes[n].get('weight', 0.0) for n in nbrs], dtype=float)
        result[i] = float(np.var(weights, ddof=0))
    return result

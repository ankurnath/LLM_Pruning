def extract_feature(G):
    import numpy as np
    import networkx as nx

    total = 0.0
    weights = {}
    for n in G:
        w = G.nodes[n].get('weight', 1.0)
        weights[n] = w
        total += w

    personalization = None
    if total > 0.0:
        personalization = {n: weights[n] / total for n in G}

    if personalization is not None:
        pr = nx.pagerank(G, alpha=0.85, personalization=personalization)
    else:
        pr = nx.pagerank(G, alpha=0.85)

    return np.asarray([pr[n] for n in G], dtype=float)

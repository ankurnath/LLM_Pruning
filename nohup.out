import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    feature = np.zeros(len(node_list))
    node_idx = {node: i for i, node in enumerate(node_list)}
    for idx, node in enumerate(node_list):
        second_neighbors = set()
        for neighbor in G.neighbors(node):
            second_neighbors.update(G.neighbors(neighbor))
        second_neighbors.discard(node)
        first_neighbors = set(G.neighbors(node))
        second_neighbors -= first_neighbors
        feature[idx] = sum(G.nodes[n]['weight'] for n in second_neighbors)
    return feature

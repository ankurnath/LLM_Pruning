import numpy as np

def extract_feature(G):
    node_order = list(G.nodes())
    n = len(node_order)
    weight_map = {n_id: G.nodes[n_id].get('weight', 0.0) for n_id in node_order}
    result = np.zeros(n, dtype=float)
    if G.is_directed():
        for i, v in enumerate(node_order):
            total = 0.0
            count = 0
            for u in G.successors(v):
                total += weight_map.get(u, 0.0)
                count += 1
            result[i] = total / count if count > 0 else 0.0
    else:
        for i, v in enumerate(node_order):
            total = 0.0
            count = 0
            for u in G.neighbors(v):
                total += weight_map.get(u, 0.0)
                count += 1
            result[i] = total / count if count > 0 else 0.0
    return result

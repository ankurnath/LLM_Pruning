def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.array([], dtype=float)
    idx_map = {node: i for i, node in enumerate(nodes)}
    weights = np.array([G.nodes[node].get('weight', 0.0) for node in nodes], dtype=float)
    feat = np.zeros(n, dtype=float)
    if G.is_directed():
        for i, v in enumerate(nodes):
            nbrs = [idx_map[u] for u in G.successors(v)]
            d = len(nbrs)
            if d:
                feat[i] = weights[nbrs].sum() / d
            else:
                feat[i] = 0.0
    else:
        for i, v in enumerate(nodes):
            nbrs = [idx_map[u] for u in G.neighbors(v)]
            d = len(nbrs)
            if d:
                feat[i] = weights[nbrs].sum() / d
            else:
                feat[i] = 0.0
    return feat

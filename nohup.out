import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        if G.is_directed():
            outs = list(G.successors(v))
        else:
            outs = list(G.neighbors(v))
        if not outs:
            feature[i] = 0.0
        else:
            for u in outs:
                _ = G.nodes[u].get('weight', 0.0)
            feature[i] = 1.0
    return feature

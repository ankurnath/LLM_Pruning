import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    neighbor_sets = {n: set(G.neighbors(n)) | {n} for n in nodes}
    result = []
    for i, n in enumerate(nodes):
        exclusive = neighbor_sets[n].copy()
        for m in nodes:
            if m != n:
                exclusive -= neighbor_sets[m]
        gain = sum(G.nodes[u]['weight'] for u in exclusive)
        result.append(gain if gain <= budget else budget)
    return np.array(result)

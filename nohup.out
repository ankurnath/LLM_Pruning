def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    if not nodes:
        return np.array([], dtype=float)
    in_deg_map = dict(G.in_degree())
    max_in_deg = max(in_deg_map.values()) if in_deg_map else 0
    if max_in_deg == 0:
        return np.zeros(len(nodes), dtype=float)
    return np.array([in_deg_map[n] for n in nodes], dtype=float) / float(max_in_deg)

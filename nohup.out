import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    weights = nx.get_node_attributes(G, 'weight')
    feature = []
    for v in nodes:
        neighbors = set(G.neighbors(v))
        exclusive_neighbors = neighbors - set().union(*(set(G.neighbors(u)) for u in neighbors if u != v))
        exclusive_weight = sum(weights[n] for n in exclusive_neighbors if n in weights)
        node_weight = weights.get(v, 0)
        val = (exclusive_weight + node_weight) / budget if budget != 0 else 0
        feature.append(val)
    return np.array(feature)

import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    weights = {n: G.nodes[n].get('weight', 0.0) for n in nodes}
    is_directed = G.is_directed()
    feature = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        if is_directed:
            neighbors = G.successors(v)
        else:
            neighbors = G.neighbors(v)
        total = 0.0
        count = 0
        for u in neighbors:
            total += weights[u]
            count += 1
        feature[i] = total / count if count > 0 else 0.0
    return feature

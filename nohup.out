import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_idx = {n: i for i, n in enumerate(nodes)}
    weights = nx.get_node_attributes(G, 'weight')
    res = np.zeros(len(nodes))
    for i, u in enumerate(nodes):
        two_hop = set([u])
        for v in G.neighbors(u):
            two_hop.add(v)
            for w in G.neighbors(v):
                two_hop.add(w)
        total_weight = sum(weights.get(x, 0) for x in two_hop)
        res[i] = min(total_weight, budget)
    return res

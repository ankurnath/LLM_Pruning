import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    N = len(node_list)
    feature = np.zeros(N)
    node_set = set(node_list)
    for idx, node in enumerate(node_list):
        neighbors = set(G.neighbors(node))
        other_nodes = node_set - {node}
        unique_neighbors = neighbors.copy()
        for other in other_nodes:
            if other == node:
                continue
            other_neighbors = set(G.neighbors(other))
            unique_neighbors -= other_neighbors
        if len(neighbors) > 0:
            frac = len(unique_neighbors) / len(neighbors)
        else:
            frac = 0.0
        feature[idx] = frac
    return feature

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    degrees = dict(G.degree())
    weights = nx.get_node_attributes(G, 'weight')
    feature = []
    for n in nodes:
        deg = degrees[n]
        w = weights.get(n, 0)
        ratio = w / deg if deg != 0 else 0
        feature.append(ratio)
    return np.array(feature)

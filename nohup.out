def extract_feature(G):
    import numpy as np
    degrees = dict(G.degree())
    nodes = list(G.nodes())
    result = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        d = degrees[v]
        if d == 0:
            result[i] = 0.0
        else:
            total = sum(degrees[u] for u in G.neighbors(v))
            result[i] = total / d
    return result

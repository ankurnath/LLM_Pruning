def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    degs = np.array([G.out_degree(v) for v in nodes], dtype=float)
    weights = np.array([G.nodes[v].get('weight', 0.0) for v in nodes], dtype=float)
    with np.errstate(divide='ignore', invalid='ignore'):
        feature = degs / weights
    return feature

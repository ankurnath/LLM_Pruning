def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    indeg = dict(G.in_degree())
    outdeg = dict(G.out_degree())
    feat = [indeg[n] + outdeg[n] for n in nodes]
    return np.asarray(feat, dtype=float)

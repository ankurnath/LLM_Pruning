import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    for i, n in enumerate(nodes):
        neighbors = list(G.neighbors(n))
        if not neighbors:
            feature[i] = 0
            continue
        core_sum = 0
        for nbr in neighbors:
            nbr_neighbors = list(G.neighbors(nbr))
            nbr_neighbors = [nn for nn in nbr_neighbors if nn != n]
            if len(nbr_neighbors) == 0:
                core = 0
            else:
                total_weight = sum(G.nodes[nn]['weight'] for nn in nbr_neighbors)
                if budget >= 1:
                    core = total_weight / min(len(nbr_neighbors), budget)
                else:
                    core = 0
            core_sum += core
        feature[i] = core_sum / len(neighbors)
    return feature

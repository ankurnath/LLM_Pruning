def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    deg = {n: G.degree(n) for n in nodes}
    neigh = {n: set(G.neighbors(n)) for n in nodes}
    result = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        second = set()
        for nb in neigh[v]:
            second.update(neigh[nb])
        second.discard(v)
        second.difference_update(neigh[v])
        if not second:
            result[i] = 0.0
        else:
            s = 0.0
            for w in second:
                s += deg[w]
            result[i] = s / len(second)
    return result

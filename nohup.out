import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    weights = {n: G.nodes[n]['weight'] for n in nodes}
    feature = np.zeros(len(nodes), dtype=float)
    node_indices = {n: i for i, n in enumerate(nodes)}
    for n in nodes:
        visited = set([n])
        one_hop = set(G.neighbors(n))
        two_hop = set()
        for nbr in one_hop:
            two_hop.update(G.neighbors(nbr))
        two_hop.difference_update(visited)
        two_hop.difference_update(one_hop)
        hops = one_hop.union(two_hop)
        total = sum(weights[x] for x in hops if x in weights)
        frac = min(total, budget) / budget if budget > 0 else 0.0
        feature[node_indices[n]] = frac
    return feature

import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    result = np.zeros(len(nodes))
    for idx, node in enumerate(nodes):
        neighbor_weights = [G.nodes[neighbor]['weight'] for neighbor in G.neighbors(node)]
        if neighbor_weights:
            core_neighbors = neighbor_weights[:budget] if budget < len(neighbor_weights) else neighbor_weights

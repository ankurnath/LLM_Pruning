import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    out_deg = dict(G.out_degree())
    directed = G.is_directed()
    feature = np.empty(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        if directed:
            neighbors = G.successors(v)
        else:
            neighbors = G.neighbors(v)
        total = 0.0
        count = 0
        for u in neighbors:
            total += out_deg.get(u, 0)
            count += 1
        feature[i] = (total / count) if count > 0 else 0.0
    return feature

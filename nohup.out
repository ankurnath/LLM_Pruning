def extract_feature(G):
    import numpy as np
    import networkx as nx

    d = 0.85
    personalization = {}
    total = 0.0
    for n in G:
        w = G.nodes[n].get('weight', 1.0)
        try:
            w_val = float(w)
        except (TypeError, ValueError):
            w_val = 1.0
        personalization[n] = w_val
        total += w_val

    if total > 0.0:
        personalization = {n: v / total for n, v in personalization.items()}
    else:
        personalization = None

    pr = nx.pagerank(G, alpha=d, personalization=personalization, weight=None)
    return np.array([pr[n] for n in G.nodes()], dtype=float)

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    feat = np.zeros(n, dtype=int)
    for i, v in enumerate(nodes):
        reachable = set()
        if hasattr(G, 'successors'):
            first_iter = G.successors(v)
        else:
            first_iter = G.neighbors(v)
        first_list = list(first_iter)
        for w in first_list:
            reachable.add(w)
        for w in first_list:
            if hasattr(G, 'successors'):
                second_iter = G.successors(w)
            else:
                second_iter = G.neighbors(w)
            for u in second_iter:
                reachable.add(u)
        reachable.discard(v)
        feat[i] = len(reachable)
    return feat

    nodes = list(G.nodes())\n    node_idx = {n: i for i, n in enumerate(nodes)}\n    n = len(nodes)\n    unique_coverage = np.zeros(n)\n    for u in nodes:\n        u_idx = node_idx[u]\n        nbrs = set(G.neighbors(u))\n        u_weight = G.nodes[u]['weight']\n        uc = 0\n        for v in nbrs:\n            shared = 0\n            for w in G.neighbors(v):\n                if w != u and w in nbrs:\n                    shared = 1\n                    break\n            if not shared:\n                uc += G.nodes[v]['weight']\n        if budget is not None:\n            uc = min(uc, budget)\n        unique_coverage[u_idx] = uc\n    return unique_coverage", 'neighbor_average_weight': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = []\n    for node in nodes:\n        neighbors = list(G.neighbors(node))\n        if not neighbors:\n            feature.append(0.0)\n            continue\n        neighbor_weights = [G.nodes[n]['weight'] for n in neighbors]\n        if budget < len(neighbor_weights):\n            avg = np.mean(sorted(neighbor_weights, reverse=True)[:budget])\n        else:\n            avg = np.mean(neighbor_weights)\n        feature.append(avg)\n    return np.array(feature)", 'inverse_neighbor_overlap': 'import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    index_map = {n: i for i, n in enumerate(nodes)}\n    feature = np.zeros(len(nodes))\n    neighbor_sets = {n: set(G.neighbors(n)) for n in nodes}\n    for n in nodes:\n        n_idx = index_map[n]\n        neighbors_n = neighbor_sets[n]\n        overlap_sum = 0\n        count = 0\n        for m in neighbors_n:\n            if m in neighbor_sets:\n                neighbors_m = neighbor_sets[m]\n                overlap = len(neighbors_n & neighbors_m)\n                union = len(neighbors_n | neighbors_m)\n                if union != 0:\n                    overlap_sum += 1 / (overlap / union) if overlap > 0 else 1\n                else:\n                    overlap_sum += 1\n                count += 1\n                if count >= budget:\n                    break\n        feature[n_idx] = overlap_sum / count if count > 0 else 0\n    return feature', 'degree_to_average_degree_ratio': 'import numpy as np\n\ndef extract_feature(G, budget):\n    degrees = np.array([G.degree(n) for n in G.nodes()])\n    avg_degree = degrees.mean() if degrees.size > 0 else 1\n    feature = degrees / avg_degree\n    return feature', 'budget_relative_impact': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    weights = np.array([G.nodes[n]['weight'] for n in nodes])\n    budget = float(budget)\n    feature = weights / (budget + 1e-8)\n    return feature"}, 'ratio': 1.0, 'size_reduction': 0.6458234930785162, 'multiplication': 0.6458234930785162}

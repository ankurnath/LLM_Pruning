import numpy as np
def extract_feature(G, budget):
    core_numbers = nx.core_number(G)
    node_list = list(G.nodes())
    weights = np.array([G.nodes[n]['weight'] for n in node_list])
    coverage_core_ratio = weights / (np.array([core_numbers[n] for n in node_list]) * budget)
    return coverage_core_ratio

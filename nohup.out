import numpy as np
from scipy.stats import entropy

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    for idx, node in enumerate(nodes):
        neighbors = list(G.neighbors(node))
        if not neighbors:
            feature[idx] = 0.0
            continue
        neighbor_degrees = np.array([G.degree(n) for n in neighbors])
        hist = np.bincount(neighbor_degrees)
        probs = hist / hist.sum()
        feature[idx] = entropy(probs)
    return feature

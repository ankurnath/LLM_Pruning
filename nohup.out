def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    feat = np.empty(n, dtype=float)
    for i, v in enumerate(nodes):
        if G.is_directed():
            nbr_iter = G.successors(v)
        else:
            nbr_iter = G.neighbors(v)
        wts = [ float(G.nodes[u].get('weight', 0.0)) for u in nbr_iter ]
        if len(wts) <= 1:
            feat[i] = 0.0
        else:
            feat[i] = float(np.std(np.asarray(wts, dtype=float), ddof=0))
    return feat

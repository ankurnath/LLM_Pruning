def extract_feature(G):
    import numpy as np
    import networkx as nx
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.array([], dtype=float)
    idx = {v: i for i, v in enumerate(nodes)}
    feats = np.zeros(n, dtype=float)
    directed = G.is_directed()
    for v in nodes:
        neigh = list(G.successors(v)) if directed else list(G.neighbors(v))
        if len(neigh) == 0:
            feats[idx[v]] = 0.0
            continue
        H = G.subgraph(neigh)
        feats[idx[v]] = nx.global_efficiency(H)
    return feats

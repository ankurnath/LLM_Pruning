import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    result = np.zeros(len(nodes))
    node_to_idx = {node: i for i, node in enumerate(nodes)}
    neighbor_sets = {n: set(G.neighbors(n)) for n in nodes}
    neighbor_sets_self = {n: neighbor_sets[n] | {n} for n in nodes}
    weights = nx.get_node_attributes(G, "weight")

    for i, n in enumerate(nodes):
        unique_coverage = 0.0
        for nbr in G.neighbors(n):
            nbr_neighbors_excl_n = neighbor_sets[nbr] - {n}
            # Check if this neighbor covers nodes not covered by other neighbors of n
            covered_only_by_nbr = nbr_neighbors_excl_n - (neighbor_sets[n] - {nbr})
            if covered_only_by_nbr:
                w = weights.get(nbr, 1.0)
                if w <= budget:
                    unique_coverage += w
        result[i] = unique_coverage
    return result

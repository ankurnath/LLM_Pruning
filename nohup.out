import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_idx = {node: i for i, node in enumerate(nodes)}
    for idx, node in enumerate(nodes):
        first_neighbors = set(G.neighbors(node))
        second_neighbors = set()
        for nbr in first_neighbors:
            second_neighbors.update(G.neighbors(nbr))
        second_neighbors.discard(node)
        second_neighbors -= first_neighbors
        total = 0
        for n in second_neighbors:
            total += G.nodes[n]['weight']
        if budget is not None:
            total = min(total, budget)
        feature[idx] = total
    return feature

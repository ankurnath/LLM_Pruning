import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    weights = {n: G.nodes[n].get('weight', 0.0) for n in G}
    values = []
    if G.is_directed():
        for v in nodes:
            total = 0.0
            count = 0
            for u in G.successors(v):
                total += weights[u]
                count += 1
            values.append(total / count if count > 0 else 0.0)
    else:
        for v in nodes:
            total = 0.0
            count = 0
            for u in G.neighbors(v):
                total += weights[u]
                count += 1
            values.append(total / count if count > 0 else 0.0)
    return np.asarray(values, dtype=float)

import numpy as np

def extract_feature(G):
    node_order = list(G.nodes())
    n = len(node_order)
    idx = {node: i for i, node in enumerate(node_order)}
    weights = {node: G.nodes[node].get('weight', 0.0) for node in node_order}
    result = np.zeros(n, dtype=float)
    for v in node_order:
        s = 0.0
        for u in G.neighbors(v):
            s += weights.get(u, 0.0)
        result[idx[v]] = s
    return result

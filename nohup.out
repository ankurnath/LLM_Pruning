******************************
import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = []
    for node in nodes:
        neighbors = set(G.neighbors(node))
        coverage_score = 0
        for neighbor in neighbors:
            neighbor2 = set(G.neighbors(neighbor)) - {node}
            dual_coverage = sum(G.nodes[n]['weight'] for n in neighbor2)
            coverage_score += dual_coverage
        node_weight = G.nodes[node]['weight']
        risk_score = (node_weight + coverage_score) / (budget + 1)
        feature.append(risk_score)
    return np.array(feature)

******************************
import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_weights = np.array([G.nodes[n]['weight'] for n in nodes])
    influence = []
    for n in nodes:
        neighbors = list(G.neighbors(n))
        neighbor_weight = sum(G.nodes[nb]['weight'] for nb in neighbors)
        total_weight = node_weights[nodes.index(n)] + neighbor_weight
        influence.append(total_weight)
    influence = np.array(influence)
    frac = np.minimum(budget, influence) / budget
    return frac

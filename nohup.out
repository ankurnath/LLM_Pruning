def extract_feature(G):
    import numpy as np
    node_order = list(G.nodes())
    n = len(node_order)
    feats = np.zeros(n, dtype=float)
    weights = {v: G.nodes[v].get('weight', 0.0) for v in node_order}
    for idx, v in enumerate(node_order):
        deg = G.degree(v)
        if deg == 0:
            feats[idx] = 0.0
        else:
            w_v = weights[v]
            cnt = 0
            for u in G.neighbors(v):
                if weights.get(u, 0.0) >= w_v:
                    cnt += 1
            feats[idx] = cnt / float(deg)
    return feats

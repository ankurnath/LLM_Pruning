import numpy as np
import networkx as nx

def extract_feature(G):
    has_edge_weight = any('weight' in data for _, _, data in G.edges(data=True))
    if has_edge_weight:
        centrality = nx.eigenvector_centrality(G, weight='weight')
    else:
        centrality = nx.eigenvector_centrality(G, weight=None)
    return np.asarray([centrality[n] for n in G.nodes()], dtype=float)

def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    weights = {n: G.nodes[n]['weight'] for n in nodes}
    feat = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        wv = weights[v]
        deg = G.degree(v)
        if deg == 0:
            feat[i] = 0.0
        else:
            cnt = 0
            for u in G.neighbors(v):
                if weights[u] > wv:
                    cnt += 1
            feat[i] = cnt / deg
    return feat

ode_weights / neighbor_means, 0)\n        feature = 1.0 / (ratio + 1e-8)\n    return feature", 'normalized_degree_weighted_coverage_gain': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    node_weights = np.array([G.nodes[n]['weight'] for n in nodes])\n    degrees = np.array([G.degree(n) for n in nodes])\n    weighted_coverage_gain = degrees * node_weights\n    norm = np.sum(weighted_coverage_gain)\n    if norm == 0:\n        normalized = np.zeros_like(weighted_coverage_gain, dtype=float)\n    else:\n        normalized = (weighted_coverage_gain / norm) * min(budget, len(nodes))\n    return normalized", 'neighbor_exclusive_coverage_sum': "import numpy as np\n\ndef extract_feature(G, budget):\n    node_list = list(G.nodes())\n    feature = np.zeros(len(node_list))\n    node_set = set(node_list)\n    for idx, n in enumerate(node_list):\n        neighbor_exclusive_sum = 0.0\n        for nbr in G.neighbors(n):\n            nbr_neighbors = set(G.neighbors(nbr))\n            exclusive = nbr_neighbors - ({n} | set(G.neighbors(n)))\n            exclusive_nodes = exclusive & node_set\n            sum_weights = sum(G.nodes[en]['weight'] for en in exclusive_nodes)\n            neighbor_exclusive_sum += sum_weights\n        feature[idx] = min(neighbor_exclusive_sum, budget)\n    return feature", 'core_number': 'import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    core_numbers = nx.core_number(G)\n    nodes = list(G.nodes())\n    return np.array([core_numbers[node] for node in nodes])', 'core_centrality_ratio': "import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    core_numbers = nx.core_number(G)\n    core_centrality = {}\n    for n in G.nodes():\n        neighbors = list(G.neighbors(n))\n        core_cent = sum(core_numbers.get(neigh, 0) for neigh in neighbors)\n        core_centrality[n] = core_cent\n    ratios = []\n    for n in G.nodes():\n        node_weight = G.nodes[n]['weight'
import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    feature = np.zeros(len(node_list))
    weights = nx.get_node_attributes(G, 'weight')
    for i, n in enumerate(node_list):
        w = weights[n]
        neighbors = list(G.neighbors(n))
        if not neighbors:
            feature[i] = 0.0
            continue
        max_neighbor_weight = max(weights[nb] for nb in neighbors)
        ratio = max_neighbor_weight / w if w != 0 else 0.0
        if budget > 0:
            ratio = min(ratio, budget)
        feature[i] = ratio
    return feature

import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_weights = np.array([G.nodes[n]['weight'] for n in node_list])
    feature = np.zeros(len(node_list))
    neighbors_dict = {n: set(G.neighbors(n)) for n in node_list}
    for idx, n in enumerate(node_list):
        local_total = node_weights[idx]
        for nbr in neighbors_dict[n]:
            nbr_idx = node_list.index(nbr)
            local_total += node_weights[nbr_idx]
        feature[idx] = node_weights[idx] / min(local_total, budget) if local_total > 0 else 0.0
    return feature

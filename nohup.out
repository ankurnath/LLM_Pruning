import numpy as np
def extract_feature(G, budget):
    nodes = list(G.nodes())
    weights = G.nodes(data='weight')
    res = np.zeros(len(nodes))
    node2idx = {n: i for i, n in enumerate(nodes)}
    for idx, n in enumerate(nodes):
        covered = set([n])
        covered.update(G.neighbors(n))
        for nbr in G.neighbors(n):
            covered.update(G.neighbors(nbr))
        gain = sum(weights[x] for x in covered if weights[x] is not None)
        res[idx] = min(gain, budget)
    return res

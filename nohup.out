def extract_feature(G):
    import numpy as np
    node_order = list(G.nodes())
    weights = {n: G.nodes[n].get('weight', 1.0) for n in node_order}
    is_directed = G.is_directed()
    out_neighbors = {}
    for v in node_order:
        if is_directed:
            nbrs = list(G.successors(v))
        else:
            nbrs = list(G.neighbors(v))
        out_neighbors[v] = nbrs
    feat = np.zeros(len(node_order), dtype=float)
    for i, v in enumerate(node_order):
        nbrs = out_neighbors[v]
        total = sum(weights.get(u, 1.0) for u in nbrs)
        if total == 0.0:
            feat[i] = 0.0
        else:
            feat[i] = sum((weights.get(u, 1.0) / total) for u in nbrs)
    return feat

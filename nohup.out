import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    n = len(nodes)
    neigh = {}
    for v in nodes:
        nbrs = set(G.neighbors(v))
        if v in nbrs:
            nbrs.discard(v)
        neigh[v] = nbrs

    result = np.zeros(n, dtype=float)
    for idx, v in enumerate(nodes):
        N = list(neigh[v])
        d = len(N)
        deg_v = G.degree(v)
        if d <= 1 or deg_v <= 1:
            result[idx] = 0.0
            continue

        count = 0
        for i in range(d):
            u = N[i]
            Nu = neigh[u]
            for j in range(i + 1, d):
                w = N[j]
                if w in Nu:
                    count += 1

        result[idx] = (2.0 * count) / (deg_v * (deg_v - 1))
    return result

def extract_feature(G):
    import numpy as np
    import networkx as nx

    if G.is_directed():
        H = G.to_undirected()
    else:
        H = G

    has_weight = False
    for _, _, data in H.edges(data=True):
        if isinstance(data, dict) and 'weight' in data:
            has_weight = True
            break

    if has_weight:
        clustering_vals = nx.clustering(H, weight='weight')
    else:
        clustering_vals = nx.clustering(H)

    nodes_order = list(G.nodes())
    result = np.array([float(clustering_vals.get(n, 0.0)) for n in nodes_order], dtype=float)
    return result

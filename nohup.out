import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    exclusive_coverage_gain = np.zeros(len(nodes))
    neighbors_dict = {n: set(G.neighbors(n)) for n in nodes}
    for idx, n in enumerate(nodes):
        n_set = neighbors_dict[n] | {n}
        exclusive = n_set - set().union(*(neighbors_dict[m] | {m} for m in node_set - {n}))
        exclusive_weight = sum(G.nodes[v]['weight'] for v in exclusive)
        exclusive_coverage_gain[idx] = exclusive_weight if budget >= G.nodes[n].get('weight', 1) else 0
    return exclusive_coverage_gain

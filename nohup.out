def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    m = len(nodes)
    weights = {n: G.nodes[n]['weight'] for n in nodes}
    feat = np.zeros(m, dtype=float)
    for i, v in enumerate(nodes):
        s = 0.0
        cnt = 0
        for nb in G.neighbors(v):
            s += weights[nb]
            cnt += 1
        feat[i] = s / cnt if cnt > 0 else 0.0
    return feat

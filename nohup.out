def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    if G.is_directed():
        out_deg_all = {u: G.out_degree(u) for u in G.nodes()}
        feature = np.zeros(n, dtype=float)
        for idx, v in enumerate(nodes):
            neigh = G.successors(v)
            degs = [out_deg_all[u] for u in neigh]
            if len(degs) == 0:
                feature[idx] = 0.0
            else:
                feature[idx] = float(np.var(np.asarray(degs, dtype=float), ddof=0))
        return feature
    else:
        deg_all = {u: G.degree(u) for u in G.nodes()}
        feature = np.zeros(n, dtype=float)
        for idx, v in enumerate(nodes):
            neigh = G.neighbors(v)
            degs = [deg_all[u] for u in neigh]
            if len(degs) == 0:
                feature[idx] = 0.0
            else:
                feature[idx] = float(np.var(np.asarray(degs, dtype=float), ddof=0))
        return feature

import numpy as np
import networkx as nx

def extract_feature(G):
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.array([], dtype=float)
    triangles = nx.triangles(G)
    deg = dict(G.degree())
    out = np.empty(n, dtype=float)
    for i, v in enumerate(nodes):
        d = deg.get(v, 0)
        if d > 1:
            t = triangles.get(v, 0)
            out[i] = (2.0 * t) / (d * (d - 1))
        else:
            out[i] = 0.0
    return out

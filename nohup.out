import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_indices = {node: idx for idx, node in enumerate(node_list)}
    weights = np.array([G.nodes[n]['weight'] for n in node_list])
    neighbors = [set(G.neighbors(n)) | {n} for n in node_list]

    cover_sets = []
    for nidx, nset in enumerate(neighbors):
        covered = set()
        covered_weight = 0
        selected = []
        for u in sorted(nset, key=lambda x: -G.nodes[x]['weight']):
            if len(selected) < budget:
                covered.add(u)
                covered_weight += G.nodes[u]['weight']
                selected.append(u)
            else:
                break
        cover_sets.append((covered, covered_weight))

    total_weights = []
    unique_weights = []
    for idx, (curr_cov, curr_tweight) in enumerate(cover_sets):
        unique = curr_cov.copy()
        for jdx, (other_cov, _) in enumerate(cover_sets):
            if idx != jdx:
                unique -= other_cov
        unique_w = sum(G.nodes[x]['weight'] for x in unique)
        total_weights.append(curr_tweight)
        unique_weights.append(unique_w)

    frac = np.divide(unique_weights, total_weights, out=np.zeros_like(unique_weights, dtype=float), where=np.array(total_weights)!=0)
    return np.array(frac)

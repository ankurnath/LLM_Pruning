import numpy as np

def extract_feature(G):
    nodes = list(G.nodes())
    feature = np.empty(len(nodes), dtype=float)
    degs = dict(G.degree())
    for i, v in enumerate(nodes):
        neigh = list(G.neighbors(v))
        m = len(neigh)
        if m < 2:
            feature[i] = np.nan
            continue
        X = np.empty(m, dtype=float)
        Y = np.empty(m, dtype=float)
        for j, u in enumerate(neigh):
            X[j] = degs[u]
            Y[j] = G.nodes[u]['weight']
        Xm = X - X.mean()
        Ym = Y - Y.mean()
        num = np.dot(Xm, Ym)
        den = np.sqrt(np.dot(Xm, Xm) * np.dot(Ym, Ym))
        feature[i] = num / den if den != 0 else np.nan
    return feature

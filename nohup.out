import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_set = set(nodes)
    exclusive_coverage_score = []
    for u in nodes:
        nbrs = set(G.neighbors(u))
        exclusive_nbrs = nbrs - set(v for v in node_set if v != u and u in G.neighbors(v))
        score = sum(G.nodes[v]['weight'] for v in exclusive_nbrs) + G.nodes[u]['weight']
        exclusive_coverage_score.append(min(score, budget))
    return np.array(exclusive_coverage_score)

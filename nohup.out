import numpy as np

def extract_feature(G, budget):
    node_list = list(G.nodes())
    node_set = set(node_list)
    features = []
    for n in node_list:
        neighbors = set(G.neighbors(n))
        unique_neighbors = neighbors - set().union(*(set(G.neighbors(m)) for m in node_list if m != n))
        numerator = sum(G.nodes[u]['weight'] for u in unique_neighbors) + G.nodes[n]['weight']
        denominator = sum(G.nodes[u]['weight'] for u in G.neighbors(n)) + G.nodes[n]['weight']
        ratio = numerator / denominator if denominator > 0 else 0.0
        features.append(ratio)
    return np.array(features)

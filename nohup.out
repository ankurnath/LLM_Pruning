def extract_feature(G):
    import numpy as np
    import networkx as nx
    if G.number_of_nodes() == 0:
        return np.array([], dtype=float)
    has_weight = any('weight' in data for _, _, data in G.edges(data=True))
    if has_weight:
        pr = nx.pagerank(G, alpha=0.85, weight='weight')
    else:
        pr = nx.pagerank(G, alpha=0.85)
    order = list(G.nodes())
    return np.array([pr.get(n, 0.0) for n in order], dtype=float)

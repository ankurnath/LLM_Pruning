def extract_feature(G):
    import numpy as np
    import networkx as nx

    use_weight = False
    for _, _, data in G.edges(data=True):
        if 'weight' in data:
            use_weight = True
            break

    if use_weight:
        all_have_weight = True
        for _, _, data in G.edges(data=True):
            if 'weight' not in data:
                all_have_weight = False
                break
        if all_have_weight:
            centrality = nx.eigenvector_centrality(G, weight='weight')
        else:
            centrality = nx.eigenvector_centrality(G)
    else:
        centrality = nx.eigenvector_centrality(G)

    order = list(G.nodes())
    return np.array([centrality[n] for n in order], dtype=float)

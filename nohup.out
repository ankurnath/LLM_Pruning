def extract_feature(G):
    import numpy as np
    n = G.number_of_nodes()
    nodes_order = list(G.nodes())
    idx = {nnode: i for i, nnode in enumerate(nodes_order)}
    weights = np.zeros(n, dtype=float)
    for nnode in nodes_order:
        weights[idx[nnode]] = float(G.nodes[nnode].get('weight', 0.0))
    feat = np.zeros(n, dtype=float)
    for v in nodes_order:
        neigh = list(G.neighbors(v))
        neigh_weights = [weights[idx[u]] for u in neigh]
        if len(neigh_weights) <= 1:
            feat[idx[v]] = 0.0
        else:
            feat[idx[v]] = float(np.std(neigh_weights, ddof=0))
    return feat

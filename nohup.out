import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    node_idx = {n: i for i, n in enumerate(nodes)}
    weights = nx.get_node_attributes(G, 'weight')
    for u in nodes:
        overlap = 0
        u_weight = weights[u]
        for v in G.neighbors(u):
            v_weight = weights[v]
            common = min(u_weight, v_weight)
            overlap += common
        feature[node_idx[u]] = overlap / budget
    return feature

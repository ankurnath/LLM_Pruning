Best model data: {'iteration': 10, 'codes': {'node_weight': "import numpy as np\n\ndef extract_feature(G, budget):\n    return np.array([min(G.nodes[n]['weight'], budget) for n in G.nodes()])", 'core_number': 'import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    core_numbers = nx.core_number(G)\n    nodes = list(G.nodes())\n    return np.array([core_numbers[node] for node in nodes])', 'second_order_degree': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = np.zeros(len(nodes))\n    node_idx = {node: i for i, node in enumerate(nodes)}\n    for i, n in enumerate(nodes):\n        neighbors = set(G.neighbors(n))\n        second_order_neighbors = set()\n        for nbr in neighbors:\n            second_order_neighbors.update(set(G.neighbors(nbr)))\n        second_order_neighbors.discard(n)\n        second_order_neighbors -= neighbors\n        feature[i] = sum(G.nodes[v].get('weight', 0) for v in second_order_neighbors)\n        if feature[i] > budget:\n            feature[i] = budget\n    return feature", 'personal_coverage_gain': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = np.array([min(G.nodes[n]['weight'], budget) for n in nodes])\n    return feature", 'residual_budget_impact': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    result = np.array([max(0, budget - G.nodes[n]['weight']) for n in nodes])\n    return result", 'average_neighbor_core_number': 'import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    core_numbers = nx.core_number(G)\n    feature = []\n    for n in G.nodes():\n        neighbors = list(G.neighbors(n))\n        if neighbors:\n            avg_core = np.mean([core_numbers[nb] for nb in neighbors])\n            feature.append(avg_core)\n        else:\n            feature.append(0.0)\n    return np.array(feature)', 'unique_two_hop_coverage': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    node_indices = {n: i for i, n in enumerate(nodes)}\n    unique_two_hop_counts = np.zeros(len(nodes), dtype=int)\n    for idx, node in enumerate(nodes):\n        if G.nodes[node].get('weight', 0) > budget:\n            continue\n        neighbors_1 = set(G.neighbors(node))\n        neighbors_2 = set()\n        for n1 in neighbors_1:\n            neighbors_2.update(G.neighbors(n1))\n        two_hop_nodes = neighbors_2 - neighbors_1 - {node}\n        unique_two_hop_counts[idx] = len(two_hop_nodes)\n    return unique_two_hop_counts", 'neighbor_weight_variance': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = np.zeros(len(nodes))\n    for i, n in enumerate(nodes):\n        neighbors = [v for v in G.neighbors(n)]\n        if budget is not None:\n            neighbors = neighbors[:budget]\n        neighbor_weights = [G.nodes[v]['weight'] for v in neighbors]\n        if len(neighbor_weights) == 0:\n            feature[i] = 0.0\n        else:\n            feature[i] = np.var(neighbor_weights)\n    return feature", 'relative_weight_budget_gap': "import numpy as np\n\ndef extract_feature(G, budget):\n    weights = np.array([G.nodes[n]['weight'] for n in G.nodes()])\n    rel_gap = (budget - weights) / np.maximum(weights, 1e-9)\n    return rel_gap", 'neighbor_average_personal_gain': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    feature = np.zeros(len(nodes))\n    for i, node in enumerate(nodes):\n        neighbors = list(G.neighbors(node))\n        if neighbors:\n            s = 0\n            for nbr in neighbors:\n                s += (budget - G.nodes[nbr]['weight'])\n            feature[i] = s / len(neighbors)\n        else:\n            feature[i] = 0\n    return feature", 'coverage_density_local': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    coverage_density = np.zeros(len(nodes))\n    for idx, n in enumerate(nodes):\n        nbrs = list(G.neighbors(n)) + [n]\n        total_weight = sum(G.nodes[u]['weight'] for u in nbrs)\n        coverage_density[idx] = total_weight / budget\n    return coverage_density", 'inverse_budget_weight_ratio': "import numpy as np\n\ndef extract_feature(G, budget):\n    weights = np.array([G.nodes[n]['weight'] for n in G.nodes()])\n    values = budget / weights\n    return values", 'max_unique_coverage_neighbor_gap': "import numpy as np\n\ndef extract_feature(G, budget):\n    node_list = list(G.nodes())\n    nodelist_idx = {n: i for i, n in enumerate(node_list)}\n    feature = np.zeros(len(node_list))\n\n    neighbor_sets = {}\n    node_weights = {}\n\n    for node in node_list:\n        neighbor_sets[node] = set(G.neighbors(node))\n        neighbor_sets[node].add(node)\n        node_weights[node] = G.nodes[node]['weight']\n\n    for node in node_list:\n        max_gap = float('-inf')\n        this_set = neighbor_sets[node]\n        this_weight = node_weights[node]\n        for nbr in G.neighbors(node):\n            if node_weights[nbr] <= budget:\n                gap = len(this_set - neighbor_sets[nbr])\n                if gap > max_gap:\n                    max_gap = gap\n        feature[nodelist_idx[node]] = max_gap if max_gap != float('-inf') else 0\n    return feature", 'weighted_neighbor_core_gap': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    node_weights = {n: G.nodes[n]['weight'] for n in nodes}\n    res = []\n    for n in nodes:\n        own_weight = node_weights[n]\n        neighbor_weights = [node_weights[nei] for nei in G.neighbors(n)]\n        if neighbor_weights:\n            max_neighbor_weight = max(neighbor_weights)\n        else:\n            max_neighbor_weight = 0\n        gap = max_neighbor_weight - own_weight\n        if budget is not None:\n            gap = min(gap, budget)\n        res.append(gap)\n    return np.array(res)", 'coverage_saturation_ratio': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    ratios = []\n    for node in nodes:\n        coverage = G.nodes[node]['weight']\n        saturation = min(coverage, budget)\n        ratio = saturation / budget if budget > 0 else 0\n        ratios.append(ratio)\n    return np.array(ratios)", 'neighbor_coverage_entropy': "import numpy as np\n\ndef extract_feature(G, budget):\n    nodes = list(G.nodes())\n    result = np.zeros(len(nodes))\n    for idx, u in enumerate(nodes):\n        neighbors = list(G.neighbors(u))\n        if not neighbors:\n            result[idx] = 0.0\n            continue\n        neighbor_weights = np.array([G.nodes[v]['weight'] for v in neighbors])\n        if neighbor_weights.sum() == 0:\n            result[idx] = 0.0\n            continue\n        prob = neighbor_weights / neighbor_weights.sum()\n        entropy = -np.sum(prob * np.log(prob))\n        result[idx] = entropy\n    return result", 'is_cut_vertex': 'import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    cut_vertex_set = set(nx.articulation_points(G))\n    node_list = list(G.nodes())\n    feature = np.array([1 if node in cut_vertex_set else 0 for node in node_list], dtype=int)\n    return feature', 'normalized_personal_coverage_gain': "import numpy as np\n\ndef extract_feature(G, budget):\n    node_list = list(G.nodes())\n    coverage_gains = np.array([G.nodes[n]['weight'] for n in node_list])\n    if coverage_gains.sum() == 0:\n        normalized_gains = np.zeros_like(coverage_gains, dtype=float)\n    else:\n        normalized_gains = coverage_gains / coverage_gains.sum()\n    feature = normalized_gains * budget\n    return feature", 'kcore_coverage_expansion_ratio': "import numpy as np\nimport networkx as nx\n\ndef extract_feature(G, budget):\n    node_list = list(G.nodes())\n    kcore = nx.core_number(G)\n    kcore_subgraphs = {}\n    k_values = set(kcore.values())\n    for k in k_values:\n        nodes_in_k = [n for n in G.nodes() if kcore[n] >= k]\n        kcore_subgraphs[k] = G.subgraph(nodes_in_k)\n    feature = []\n    for node in node_list:\n        k = kcore[node]\n        subG = kcore_subgraphs[k]\n        neighbors = set(subG.neighbors(node))\n        neighbor_weights = [(nbr, G.nodes[nbr]['weight']) for nbr in neighbors if nbr != node]\n        neighbor_weights.sort(key=lambda x: -x[1])\n        expanded = set(n for n, w in neighbor_weights[:budget])\n        if not expanded:\n            ratio = 0.0\n        else:\n            covered = set(expanded)\n            for n in expanded:\n                covered |= set(subG.neighbors(n))\n            coverage_ratio = len(covered) / subG.number_of_nodes() if subG.number_of_nodes() > 0 else 0\n            initial_coverage = (1 + len(neighbors)) / subG.number_of_nodes() if subG.number_of_nodes() > 0 else 0\n            ratio = coverage_ratio / initial_coverage if initial_coverage > 0 else 0\n        feature.append(ratio)\n    return np.array(feature)"}, 'ratio': 1.0, 'size_reduction': 0.6180482686253934, 'multiplication': 0.6180482686253934}

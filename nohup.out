import numpy as np
import networkx as nx

def extract_feature(G, budget):
    core_number_full = nx.core_number(G)
    features = []
    for node in G.nodes():
        removed_nodes = [n for n in G.nodes if G.nodes[n]['weight'] <= budget]
        if node in removed_nodes:
            features.append(0)
        else:
            G_sub = G.copy()
            G_sub.remove_nodes_from(removed_nodes)
            if node in G_sub:
                core_number_sub = nx.core_number(G_sub)
                gap = core_number_full[node] - core_number_sub.get(node, 0)
            else:
                gap = core_number_full[node]
            features.append(gap)
    return np.array(features)

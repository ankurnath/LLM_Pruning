import numpy as np

def extract_feature(G):
    deg = dict(G.degree())
    nodes = list(G.nodes())
    out = np.zeros(len(nodes), dtype=float)
    for i, v in enumerate(nodes):
        neigh = list(G.neighbors(v))
        if not neigh:
            out[i] = 0.0
        else:
            neigh_degs = [deg[u] for u in neigh]
            out[i] = float(np.std(neigh_degs, ddof=0))
    return out

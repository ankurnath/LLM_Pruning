import numpy as np
from scipy.stats import skew

def extract_feature(G, budget):
    nodes = list(G.nodes())
    feature = np.zeros(len(nodes))
    for i, u in enumerate(nodes):
        neighbors = list(G.neighbors(u))
        weights = [G.nodes[v]['weight'] for v in neighbors]
        if budget > 0:
            weights = weights[:budget]
        if weights:
            feature[i] = skew(weights, bias=False)
        else:
            feature[i] = 0.0
    return feature

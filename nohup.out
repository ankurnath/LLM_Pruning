import numpy as np

def extract_feature(G):
    n = G.number_of_nodes()
    if n == 0:
        return np.array([], dtype=float)
    try:
        b = budget
    except NameError:
        b = 0
    alpha = 0
    factor = b / n
    nodes = list(G.nodes())
    out_deg = dict(G.out_degree())
    vals = [factor * (out_deg.get(v, 0) - alpha) for v in nodes]
    return np.asarray(vals, dtype=float)

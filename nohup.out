def extract_feature(G):
    import numpy as np
    outdeg = dict(G.out_degree())
    n = G.number_of_nodes()
    feat = np.empty(n, dtype=int)
    for i, v in enumerate(G.nodes()):
        max_deg = 0
        for u in G.successors(v):
            du = outdeg.get(u, 0)
            if du > max_deg:
                max_deg = du
        feat[i] = max_deg
    return feat

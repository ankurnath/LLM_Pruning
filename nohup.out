import numpy as np

def extract_feature(G, budget):
    nodes = list(G.nodes())
    node_index = {n: i for i, n in enumerate(nodes)}
    feature = np.zeros(len(nodes))
    for i, u in enumerate(nodes):
        s = 0.0
        count = 0
        for v in nx.single_source_shortest_path_length(G, u, cutoff=budget):
            if u == v:
                continue
            dist = nx.shortest_path_length(G, u, v)
            if 0 < dist <= budget:
                s += G.nodes[v]['weight'] / dist
                count += 1
        feature[i] = s
    return feature

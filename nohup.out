def extract_feature(G):
    import numpy as np
    nodes = list(G.nodes())
    n = len(nodes)
    if n == 0:
        return np.zeros(0, dtype=float)
    idx = {node: i for i, node in enumerate(nodes)}
    sum_out_prob = np.zeros(n, dtype=float)
    neighbor_weight_sum = np.zeros(n, dtype=float)

    if G.is_directed():
        for u in nodes:
            i = idx[u]
            for v, data in G[u].items():
                prob = data.get('prob')
                if prob is None:
                    prob = data.get('p')
                    if prob is None:
                        prob = data.get('weight', 0.0)
                sum_out_prob[i] += float(prob)
                neighbor_weight_sum[i] += float(G.nodes[v].get('weight', 0.0))
    else:
        for u in nodes:
            i = idx[u]
            for v, data in G[u].items():
                prob = data.get('prob')
                if prob is None:
                    prob = data.get('p')
                    if prob is None:
                        prob = data.get('weight', 0.0)
                sum_out_prob[i] += float(prob)
                neighbor_weight_sum[i] += float(G.nodes[v].get('weight', 0.0))

    feature = sum_out_prob * neighbor_weight_sum
    return feature
